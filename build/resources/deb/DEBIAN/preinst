#!/bin/sh

set -e

case "$1" in
    install|upgrade)
        if pgrep -f '/opt/gitnest/gitnest' > /dev/null; then
            echo "Stopping running GitNest instance..."
            pkill -f '/opt/gitnest/gitnest' || true
            sleep 1
        fi
    ;;

    abort-upgrade)
    ;;

    *)
        echo "preinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0

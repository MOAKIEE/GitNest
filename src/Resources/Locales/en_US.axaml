  <x:String x:Key="Text.RemoveWorktree.FollowUpKeepOrForceHint" xml:space="preserve">The linked worktree directory has been removed. You can stop here and keep the unmerged branch, or explicitly force-delete it (-D; a 30-day backup ref will be created first).</x:String>
  <x:String x:Key="Text.RemoveWorktree.FollowUpUnmergedHeader" xml:space="preserve">Worktree removed, but regular delete (-d) stopped: branch '{0}' has {1} unmerged commit(s):</x:String>

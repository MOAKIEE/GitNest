  <x:String x:Key="Text.Discard.BaselineTitle" xml:space="preserve">Discard Baseline</x:String>
  <x:String x:Key="Text.Discard.Baseline.ToIndex" xml:space="preserve">Restore working tree to Index (keep staged changes)</x:String>
  <x:String x:Key="Text.Discard.Baseline.ToIndex.Desc" xml:space="preserve">Reverts unstaged edits back to the current index snapshot while keeping staged changes untouched.</x:String>
  <x:String x:Key="Text.Discard.Baseline.ToHead" xml:space="preserve">Restore to HEAD (clear both staged &amp; unstaged)</x:String>
  <x:String x:Key="Text.Discard.Baseline.ToHead.Desc" xml:space="preserve">Restores tracked files back to the last commit (HEAD); newly staged files not yet in HEAD are backed up and removed using the selected deletion mode.</x:String>
  <x:String x:Key="Text.Discard.Baseline.CleanUntracked" xml:space="preserve">Clean untracked files</x:String>
  <x:String x:Key="Text.Discard.Baseline.CleanUntracked.Recycle.Desc" xml:space="preserve">Cleans only selected untracked files/symlinks (skipping .git, ignored items, submodules, and nested repos), saves a 30-day local backup, and moves them to the OS Recycle Bin.</x:String>
  <x:String x:Key="Text.Discard.Baseline.CleanUntracked.Direct.Desc" xml:space="preserve">Cleans only selected untracked files/symlinks (skipping .git, ignored items, submodules, and nested repos), saves a 30-day local backup, and deletes them directly from disk.</x:String>
  <x:String x:Key="Text.Discard.BaselineLabel.ToIndex" xml:space="preserve">Working Tree → Index</x:String>
  <x:String x:Key="Text.Discard.BaselineLabel.ToHead" xml:space="preserve">Working Tree + Index → HEAD</x:String>
  <x:String x:Key="Text.Discard.BaselineLabel.ToHeadDirect" xml:space="preserve">Working Tree + Index → HEAD (Direct Delete)</x:String>
  <x:String x:Key="Text.Discard.BaselineLabel.Recycle" xml:space="preserve">Untracked → Recycle Bin</x:String>
  <x:String x:Key="Text.Discard.BaselineLabel.DirectDelete" xml:space="preserve">Untracked → Direct Delete</x:String>
  <x:String x:Key="Text.Discard.RemovalModeTitle" xml:space="preserve">Deletion Mode</x:String>
  <x:String x:Key="Text.Discard.DirectRemovalWarning" xml:space="preserve">Selected files will be deleted directly, bypassing the system Recycle Bin. You can still restore them within 30 days from the local recovery backup.</x:String>
  <x:String x:Key="Text.Discard.Confirm.ToIndex" xml:space="preserve">RESTORE TO INDEX</x:String>
  <x:String x:Key="Text.Discard.Confirm.ToHead" xml:space="preserve">RESTORE TO HEAD</x:String>
  <x:String x:Key="Text.Discard.Confirm.Recycle" xml:space="preserve">MOVE TO RECYCLE BIN</x:String>

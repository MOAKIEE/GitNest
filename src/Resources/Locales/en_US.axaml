  <x:String x:Key="Text.Discard.IndexAddedOnlyNotice" xml:space="preserve">{0} newly staged file(s) do not exist in HEAD yet and will be moved to the Recycle Bin after backup.</x:String>
  <x:String x:Key="Text.Discard.IndexAddedOnlyNotice.Direct" xml:space="preserve">{0} newly staged file(s) do not exist in HEAD yet and will be backed up for 30 days before direct deletion.</x:String>

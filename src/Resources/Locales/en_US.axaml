  <x:String x:Key="Text.RemoveWorktree.ForceDeleteRemainingBranchBtn" xml:space="preserve">Force Delete Remaining Branch (-D)</x:String>
  <x:String x:Key="Text.RemoveWorktree.ForceLossWarning" xml:space="preserve">WARNING: Permanent local data loss! Forcing removal will directly delete directory '{0}' and all {1} listed file(s), including ignored files, without moving them to the Recycle Bin.</x:String>
  <x:String x:Key="Text.RemoveWorktree.ForceOptionLabel" xml:space="preserve">I understand the permanent data-loss risk and explicitly force remove (--force)</x:String>

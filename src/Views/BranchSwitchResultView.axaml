<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="220"
             x:Class="SourceGit.Views.BranchSwitchResultView"
             x:DataType="vm:BranchSwitchPopup">
  <StackPanel Orientation="Vertical" Spacing="8">
    <!-- Phase 2: Explicit Submodule Update Confirmation -->
    <Border Background="{DynamicResource Brush.Contents}"
            BorderBrush="{DynamicResource Brush.Border1}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="12,10"
            IsVisible="{Binding IsAwaitingSubmoduleConfirm, Mode=OneWay}">
      <StackPanel Orientation="Vertical" Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Width="16" Height="16" Data="{StaticResource Icons.Submodules}" Fill="{DynamicResource Brush.Accent}"/>
          <TextBlock FontSize="13.5" FontWeight="Bold" Text="{DynamicResource Text.Checkout.Submodules.ConfirmTitle}"/>
        </StackPanel>

        <TextBlock FontSize="12" Text="{Binding SubmoduleConfirmSummary, Mode=OneWay}" TextWrapping="Wrap"/>

        <Border Padding="8,6"
                CornerRadius="3"
                Background="{DynamicResource Brush.Conflict}"
                IsVisible="{Binding HasUninitializedSubmodules, Mode=OneWay}">
          <TextBlock FontSize="11.5"
                     Foreground="{DynamicResource Brush.Conflict.Foreground}"
                     TextWrapping="Wrap"
                     Text="{DynamicResource Text.Checkout.Submodules.ConfirmInitNotice}"/>
        </Border>

        <Border Background="{DynamicResource Brush.SubPanel}"
                BorderBrush="{DynamicResource Brush.Border2}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="8,6">
          <ScrollViewer MaxHeight="140"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding AffectedSubmodules, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="x:String">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,2">
                    <Path Grid.Column="0" Width="12" Height="12" Data="{StaticResource Icons.Submodule}" Fill="{DynamicResource Brush.FG2}"/>
                    <TextBlock Grid.Column="1"
                               FontSize="12"
                               FontFamily="{DynamicResource Fonts.Monospace}"
                               Text="{Binding}"
                               TextWrapping="Wrap"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <CheckBox IsChecked="{Binding RecursiveSubmoduleUpdate, Mode=TwoWay}">
          <TextBlock Text="{DynamicResource Text.Checkout.UpdateSubmodulesRecursive}" TextWrapping="Wrap"/>
        </CheckBox>
      </StackPanel>
    </Border>

    <!-- Partial Success: Main Branch Switched, Submodule Update Failed -->
    <Border Background="{DynamicResource Brush.Contents}"
            BorderBrush="{DynamicResource Brush.Border1}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="12,10"
            IsVisible="{Binding IsSubmoduleFailureResult, Mode=OneWay}">
      <StackPanel Orientation="Vertical" Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Width="16" Height="16" Data="{StaticResource Icons.Error}" Fill="#D97706"/>
          <TextBlock FontSize="13.5" FontWeight="Bold" Text="{Binding ResultTitle, Mode=OneWay}"/>
        </StackPanel>

        <TextBlock FontSize="12" Text="{Binding ResultSummary, Mode=OneWay}" TextWrapping="Wrap"/>

        <Border Padding="8,6"
                CornerRadius="3"
                Background="#1816A34A"
                BorderBrush="#5516A34A"
                BorderThickness="1">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Path Grid.Column="0" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icons.CheckCircled}" Fill="#16A34A"/>
            <TextBlock Grid.Column="1" FontSize="12" Text="{Binding MainBranchOutcomeText, Mode=OneWay}" TextWrapping="Wrap"/>
          </Grid>
        </Border>

        <Border Padding="8,6"
                CornerRadius="3"
                Background="#1AE05252"
                BorderBrush="#66E05252"
                BorderThickness="1">
          <StackPanel Orientation="Vertical" Spacing="4">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <Path Grid.Column="0" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icons.Error}" Fill="#E05252"/>
              <TextBlock Grid.Column="1" FontSize="12" Text="{Binding SubmoduleFailureText, Mode=OneWay}" TextWrapping="Wrap"/>
            </Grid>

            <ScrollViewer MaxHeight="110"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding ResultLines.Count, Converter={x:Static c:IntConverters.IsGreaterThanZero}}">
              <ItemsControl ItemsSource="{Binding ResultLines, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="x:String">
                    <TextBlock FontSize="11.5"
                               FontFamily="{DynamicResource Fonts.Monospace}"
                               Text="{Binding}"
                               Margin="22,1,0,1"
                               TextWrapping="Wrap"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- General Switch Failure / Stash Retained -->
    <Border Background="{DynamicResource Brush.Contents}"
            BorderBrush="{DynamicResource Brush.Border1}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="12,10"
            IsVisible="{Binding IsGeneralSwitchFailure, Mode=OneWay}">
      <StackPanel Orientation="Vertical" Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Width="16" Height="16" Data="{StaticResource Icons.Info}" Fill="#D97706" IsVisible="{Binding IsResultConflictRetained}"/>
          <Path Width="16" Height="16" Data="{StaticResource Icons.Error}" Fill="#E05252" IsVisible="{Binding !IsResultConflictRetained}"/>
          <TextBlock FontSize="13.5" FontWeight="Bold" Text="{Binding ResultTitle}"/>
        </StackPanel>

        <TextBlock FontSize="12" Text="{Binding ResultSummary}" TextWrapping="Wrap"/>

        <ScrollViewer MaxHeight="140"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding ResultLines.Count, Converter={x:Static c:IntConverters.IsGreaterThanZero}}">
          <ItemsControl ItemsSource="{Binding ResultLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="x:String">
                <TextBlock FontSize="11.5"
                           FontFamily="{DynamicResource Fonts.Monospace}"
                           Text="{Binding}"
                           Margin="0,1"
                           TextWrapping="Wrap"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SourceGit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceGit.Views.EditWorktreeTask"
             x:DataType="vm:EditWorktreeTask">
  <StackPanel Orientation="Vertical" Margin="8,0,0,0">
    <StackPanel Orientation="Horizontal">
      <Path Width="16" Height="16"
            Data="{StaticResource Icons.Edit}"/>

      <TextBlock FontSize="18"
                 Margin="8,0,0,0"
                 Classes="bold"
                 Text="{DynamicResource Text.Worktree.Task.Edit}"/>
    </StackPanel>

    <Grid Margin="8,16,0,0" RowDefinitions="Auto,8,32,32,Auto" ColumnDefinitions="108,*">
      <TextBlock Grid.Row="0" Grid.Column="0"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,2,8,0"
                 Text="{DynamicResource Text.Worktree.Path}"/>
      <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="Auto,*">
        <Path Grid.Column="0" Width="12" Height="12"
              Margin="0,3,0,0" VerticalAlignment="Top"
              Data="{StaticResource Icons.Worktree}"/>
        <TextBlock Grid.Column="1" Margin="6,0,0,0"
                   Text="{Binding Target.FullPath}" TextWrapping="Wrap"/>
      </Grid>

      <TextBlock Grid.Row="2" Grid.Column="0"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,8,0"
                 Text="{DynamicResource Text.Worktree.Task.AliasLabel}"/>
      <TextBox Grid.Row="2" Grid.Column="1"
               Height="28" CornerRadius="3"
               Text="{Binding Alias, Mode=TwoWay}"
               Watermark="{DynamicResource Text.Worktree.Task.Alias}"
               MaxLength="120"/>

      <CheckBox Grid.Row="3" Grid.Column="1"
                Content="{DynamicResource Text.Worktree.Task.MarkCompleted}"
                IsChecked="{Binding IsCompleted, Mode=TwoWay}"/>

      <TextBlock Grid.Row="4" Grid.Column="1"
                 Margin="0,2,0,0"
                 FontSize="12"
                 Foreground="{DynamicResource Brush.FG2}"
                 Text="{DynamicResource Text.Worktree.Task.LocalOnly}"
                 TextWrapping="Wrap"/>
    </Grid>

    <Border Margin="8,14,0,0" Padding="10,8" CornerRadius="4"
            BorderThickness="1" BorderBrush="{DynamicResource Brush.Border0}"
            Background="{DynamicResource Brush.Contents}">
      <StackPanel Spacing="4">
        <TextBlock FontSize="12" Text="{Binding Target.AvailabilityDescription}" TextWrapping="Wrap"/>
        <TextBlock FontSize="12" Foreground="{DynamicResource Brush.FG2}" Text="{Binding Target.ChangesDescription}" TextWrapping="Wrap"/>
        <TextBlock FontSize="12" Foreground="{DynamicResource Brush.FG2}" Text="{Binding Target.SyncDescription}" TextWrapping="Wrap"/>
        <TextBlock FontSize="11.5" Foreground="{DynamicResource Brush.FG2}" Text="{Binding Target.RefreshDescription}" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>

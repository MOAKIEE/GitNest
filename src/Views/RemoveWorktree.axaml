<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="480"
             x:Class="SourceGit.Views.RemoveWorktree"
             x:DataType="vm:RemoveWorktree"
             MaxWidth="620">
  <StackPanel Orientation="Vertical" Margin="8,0">
    <!-- Title -->
    <StackPanel Orientation="Horizontal">
      <Path Width="16" Height="16" Data="{StaticResource Icons.Clear}"/>
      <TextBlock FontSize="18"
                 Margin="8,0,0,0"
                 Classes="bold"
                 Text="{DynamicResource Text.RemoveWorktree}"/>
    </StackPanel>

    <ScrollViewer MaxHeight="510"
                  Margin="0,10,0,0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Orientation="Vertical" Spacing="8">
        <!-- Worktree Target Summary Card -->
        <Border Padding="10,6"
                CornerRadius="4"
                Background="{DynamicResource Brush.Contents}"
                BorderThickness="1"
                BorderBrush="{DynamicResource Brush.Border1}">
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Path Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0" Data="{StaticResource Icons.Worktree}"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="bold" Text="{Binding Target.Name}"/>
                <Border Height="18"
                        Padding="6,0"
                        VerticalAlignment="Center"
                        CornerRadius="9"
                        Background="{DynamicResource Brush.Badge}">
                  <TextBlock Foreground="{DynamicResource Brush.BadgeFG}"
                             FontFamily="{DynamicResource Fonts.Monospace}"
                             FontSize="10"
                             VerticalAlignment="Center"
                             Text="{Binding BranchDisplay, Mode=OneWay}"/>
                </Border>
                <TextBlock Foreground="{DynamicResource Brush.FG2}"
                           FontFamily="{DynamicResource Fonts.Monospace}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Text="{Binding HeadShortSha, Mode=OneWay}"/>
              </StackPanel>
              <Button Grid.Column="2"
                      Classes="flat"
                      Height="22"
                      Padding="8,0"
                      FontSize="11"
                      Content="{DynamicResource Text.RemoveWorktree.RefreshPreflightBtn}"
                      Click="OnRefreshPreflight"/>
            </Grid>

            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0" FontSize="11" Foreground="{DynamicResource Brush.FG2}" Margin="0,0,8,0" Text="{DynamicResource Text.RemoveWorktree.PathLabel}"/>
              <TextBlock Grid.Column="1" FontSize="11" FontFamily="{DynamicResource Fonts.Monospace}" TextWrapping="Wrap" Text="{Binding TargetFullPath}"/>
            </Grid>

            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0" FontSize="11" Foreground="{DynamicResource Brush.FG2}" Margin="0,0,8,0" Text="{DynamicResource Text.RemoveWorktree.SyncLabel}"/>
              <TextBlock Grid.Column="1" FontSize="11" TextWrapping="Wrap" Text="{Binding SyncSummaryText, Mode=OneWay}"/>
            </Grid>

            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding ShowConfigurationForm, Mode=OneWay}">
              <Path Grid.Column="0" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,6,0" Data="{StaticResource Icons.Info}" Fill="{DynamicResource Brush.FG2}"/>
              <TextBlock Grid.Column="1"
                         FontSize="11"
                         Foreground="{DynamicResource Brush.FG2}"
                         TextWrapping="Wrap"
                         Text="{DynamicResource Text.RemoveWorktree.PermanentSafetyHint}"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Configuration View -->
        <StackPanel Orientation="Vertical"
                    Spacing="8"
                    IsVisible="{Binding ShowConfigurationForm, Mode=OneWay}">
          <TextBlock FontSize="11"
                     Foreground="{DynamicResource Brush.FG2}"
                     Text="{DynamicResource Text.RemoveWorktree.LoadingPreflight}"
                     IsVisible="{Binding IsLoadingPreflight, Mode=OneWay}"/>

          <!-- Open tab switch notice -->
          <Border Padding="10,8"
                  CornerRadius="4"
                  Background="#1E2563EB"
                  BorderThickness="1"
                  BorderBrush="#552563EB"
                  IsVisible="{Binding IsTargetOpenInGitNest, Mode=OneWay}">
            <Grid ColumnDefinitions="Auto,*">
              <Path Grid.Column="0" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,8,0" Data="{StaticResource Icons.Info}" Fill="DodgerBlue"/>
              <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{DynamicResource Text.RemoveWorktree.OpenTabWillSwitchHint}"/>
            </Grid>
          </Border>

          <!-- Detached HEAD commit backup notice -->
          <Border Padding="10,8"
                  CornerRadius="4"
                  Background="#1E2563EB"
                  BorderThickness="1"
                  BorderBrush="#552563EB"
                  IsVisible="{Binding IsDetached, Mode=OneWay}">
            <Grid ColumnDefinitions="Auto,*">
              <Path Grid.Column="0" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,8,0" Data="{StaticResource Icons.Info}" Fill="DodgerBlue"/>
              <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{DynamicResource Text.RemoveWorktree.DetachedBackupHint}"/>
            </Grid>
          </Border>

          <!-- Directory missing / offline -->
          <Border Padding="10,8"
                  CornerRadius="4"
                  Background="#1EFF8C00"
                  BorderThickness="1"
                  BorderBrush="#55FF8C00"
                  IsVisible="{Binding IsDirectoryMissing, Mode=OneWay}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="Auto,*">
                <Path Grid.Column="0" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,8,0" Data="{StaticResource Icons.Error}" Fill="DarkOrange"/>
                <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{DynamicResource Text.RemoveWorktree.MissingDirectoryHint}"/>
              </Grid>
              <Button Classes="flat"
                      Height="26"
                      HorizontalAlignment="Left"
                      Padding="12,0"
                      Content="{DynamicResource Text.RemoveWorktree.OpenPrunePreviewBtn}"
                      Click="OnOpenPrunePreview"/>
            </StackPanel>
          </Border>

          <!-- Locked worktree block + explicit unlock & re-inspect -->
          <Border Padding="10,8"
                  CornerRadius="4"
                  Background="#1EFF8C00"
                  BorderThickness="1"
                  BorderBrush="#55FF8C00"
                  IsVisible="{Binding IsLocked, Mode=OneWay}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="Auto,*">
                <Path Grid.Column="0" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,8,0" Data="{StaticResource Icons.Lock}" Fill="DarkOrange"/>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Classes="bold" TextWrapping="Wrap" Text="{DynamicResource Text.RemoveWorktree.LockedTitle}"/>
                  <TextBlock FontSize="11" TextWrapping="Wrap" Text="{Binding LockReasonDisplay, Mode=OneWay}"/>
                  <TextBlock FontSize="11" Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" Text="{DynamicResource Text.RemoveWorktree.LockedExplain}"/>
                </StackPanel>
              </Grid>
              <CheckBox IsChecked="{Binding UnlockAcknowledged, Mode=TwoWay}"
                        Content="{DynamicResource Text.RemoveWorktree.ConfirmUnlockCheck}"/>
              <Button Classes="flat primary"
                      Height="28"
                      HorizontalAlignment="Left"
                      Padding="12,0"
                      IsEnabled="{Binding CanUnlockWorktree, Mode=OneWay}"
                      Content="{DynamicResource Text.RemoveWorktree.UnlockAndReinspectBtn}"
                      Click="OnUnlockAndReinspect"/>
            </StackPanel>
          </Border>

          <!-- Nested Git repo or submodule hard block -->
          <Border Padding="10,8"
                  CornerRadius="4"
                  Background="#1EDC2626"
                  BorderThickness="1"
                  BorderBrush="#55DC2626"
                  IsVisible="{Binding HasNestedRepoOrSubmodule, Mode=OneWay}">
            <Grid ColumnDefinitions="Auto,*">
              <Path Grid.Column="0" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,8,0" Data="{StaticResource Icons.Error}" Fill="OrangeRed"/>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Classes="bold" TextWrapping="Wrap" Text="{DynamicResource Text.RemoveWorktree.NestedBlockedTitle}"/>
                <TextBlock FontFamily="{DynamicResource Fonts.Monospace}" FontSize="11" TextWrapping="Wrap" Text="{Binding NestedPathsDisplay, Mode=OneWay}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Uncommitted, untracked & gitignored file inspection breakdown -->
          <Border Padding="10,8"
                  CornerRadius="4"
                  Background="#1EFF8C00"
                  BorderThickness="1"
                  BorderBrush="#55FF8C00"
                  IsVisible="{Binding HasInspectableFiles, Mode=OneWay}">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="Auto,*">
                <Path Grid.Column="0" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,8,0" Data="{StaticResource Icons.Error}" Fill="DarkOrange"/>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Classes="bold" TextWrapping="Wrap" Text="{Binding FileBreakdownSummary, Mode=OneWay}"/>
                  <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG1}" Text="{DynamicResource Text.RemoveWorktree.DirtyAndIgnoredBlockHint}"/>
                </StackPanel>
              </Grid>

              <Border Padding="8,5"
                      CornerRadius="4"
                      Background="{DynamicResource Brush.Contents}"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource Brush.Border1}">
                <StackPanel Spacing="4">
                  <TextBlock Classes="bold"
                             FontSize="11"
                             Foreground="{DynamicResource Brush.FG2}"
                             Text="{DynamicResource Text.RemoveWorktree.ExpandFilesHeader}"/>
                  <ScrollViewer MaxHeight="95" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding BlockingFiles}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:WorktreeFilePreviewItem">
                          <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                            <Border Grid.Column="0"
                                    Height="16"
                                    Padding="5,0"
                                    Margin="0,0,8,0"
                                    CornerRadius="3"
                                    VerticalAlignment="Center"
                                    Background="{Binding BadgeBackground}">
                              <TextBlock FontSize="10" Foreground="White" VerticalAlignment="Center" Text="{Binding CategoryBadge}"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       FontFamily="{DynamicResource Fonts.Monospace}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding RelativePath}"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Separate Explicit Force Delete Check + Secondary Path/Loss Confirmation -->
          <StackPanel Spacing="6" IsVisible="{Binding CanShowForceOption, Mode=OneWay}">
            <CheckBox IsChecked="{Binding Force, Mode=TwoWay}">
              <TextBlock TextWrapping="Wrap" Text="{DynamicResource Text.RemoveWorktree.ForceOptionLabel}"/>
            </CheckBox>
            <Border Padding="10,8"
                    CornerRadius="4"
                    Background="#1EDC2626"
                    BorderThickness="1"
                    BorderBrush="#55DC2626"
                    IsVisible="{Binding ShowForceLossWarning, Mode=OneWay}">
              <Grid ColumnDefinitions="Auto,*">
                <Path Grid.Column="0" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,8,0" Data="{StaticResource Icons.Error}" Fill="OrangeRed"/>
                <TextBlock Grid.Column="1" Classes="bold" TextWrapping="Wrap" Text="{Binding ForceLossWarningText, Mode=OneWay}"/>
              </Grid>
            </Border>
          </StackPanel>

          <!-- Optional Linked Branch & Upstream Remote Cleanup -->
          <StackPanel Spacing="6" IsVisible="{Binding CanOfferLocalBranchDelete, Mode=OneWay}">
            <CheckBox IsChecked="{Binding DeleteLocalBranch, Mode=TwoWay}"
                      Content="{Binding DeleteLocalBranchOptionText, Mode=OneWay}"/>

            <Grid Margin="20,0,0,0"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8"
                  IsVisible="{Binding ShowRemoteBranchOption, Mode=OneWay}">
              <CheckBox Grid.Column="0" IsChecked="{Binding DeleteRemoteBranch, Mode=TwoWay}">
                <TextBlock TextWrapping="Wrap" Text="{Binding DeleteRemoteBranchOptionText, Mode=OneWay}"/>
              </CheckBox>
              <Border Grid.Column="1"
                      Height="18"
                      Padding="6,0"
                      CornerRadius="9"
                      VerticalAlignment="Center"
                      Background="{DynamicResource Brush.Badge}"
                      IsVisible="{Binding IsUpstreamNameDifferent, Mode=OneWay}">
                <TextBlock FontSize="10"
                           Foreground="{DynamicResource Brush.BadgeFG}"
                           VerticalAlignment="Center"
                           Text="{DynamicResource Text.DeleteBranch.DifferentUpstreamNameTag}"/>
              </Border>
            </Grid>

            <!-- Multi-Target Cleanup Summary -->
            <Border Padding="10,8"
                    CornerRadius="4"
                    Background="{DynamicResource Brush.Contents}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource Brush.Border1}"
                    IsVisible="{Binding ShowCleanupBreakdown, Mode=OneWay}">
              <StackPanel Spacing="4">
                <TextBlock Classes="bold" FontSize="11" Text="{DynamicResource Text.RemoveWorktree.OrderedTargetsTitle}"/>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                  <TextBlock Grid.Row="0" Grid.Column="0" FontSize="11" Foreground="{DynamicResource Brush.FG2}" Margin="0,0,8,0" Text="{DynamicResource Text.RemoveWorktree.TargetStep1Worktree}"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" FontSize="11" FontFamily="{DynamicResource Fonts.Monospace}" TextWrapping="Wrap" Text="{Binding TargetFullPath}"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" FontSize="11" Foreground="{DynamicResource Brush.FG2}" Margin="0,2,8,0" Text="{DynamicResource Text.RemoveWorktree.TargetStep2Local}"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" FontFamily="{DynamicResource Fonts.Monospace}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding BranchDisplay, Mode=OneWay}"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" FontSize="11" Foreground="{DynamicResource Brush.FG2}" Margin="0,2,8,0" IsVisible="{Binding ShowRemoteTargetRow, Mode=OneWay}" Text="{DynamicResource Text.RemoveWorktree.TargetStep3Remote}"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" FontSize="11" FontFamily="{DynamicResource Fonts.Monospace}" Margin="0,2,0,0" IsVisible="{Binding ShowRemoteTargetRow, Mode=OneWay}" TextWrapping="Wrap" Text="{Binding ConfiguredUpstreamFriendly, Mode=OneWay}"/>

                  <TextBlock Grid.Row="3" Grid.Column="0" FontSize="11" Foreground="{DynamicResource Brush.FG2}" Margin="0,2,8,0" IsVisible="{Binding ShowRemoteTargetRow, Mode=OneWay}" Text="{DynamicResource Text.DeleteBranch.RemoteUrlLabel}"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" FontSize="11" FontFamily="{DynamicResource Fonts.Monospace}" Margin="0,2,0,0" IsVisible="{Binding ShowRemoteTargetRow, Mode=OneWay}" TextWrapping="Wrap" Text="{Binding RedactedRemoteUrl, Mode=OneWay}"/>

                  <TextBlock Grid.Row="4" Grid.Column="0" FontSize="11" Foreground="{DynamicResource Brush.FG2}" Margin="0,2,8,0" VerticalAlignment="Center" IsVisible="{Binding ShowRemoteTargetRow, Mode=OneWay}" Text="{DynamicResource Text.DeleteBranch.RemoteTipLabel}"/>
                  <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2,0,0" IsVisible="{Binding ShowRemoteTargetRow, Mode=OneWay}">
                    <TextBlock Grid.Column="0" FontSize="11" FontFamily="{DynamicResource Fonts.Monospace}" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding RemoteLiveStatusText, Mode=OneWay}"/>
                    <Button Grid.Column="1" Classes="flat" Height="22" Margin="8,0,0,0" Padding="8,0" VerticalAlignment="Center" FontSize="11" Content="{DynamicResource Text.DeleteBranch.RefreshRemoteBtn}" Click="OnRefreshRemoteProbe"/>
                  </Grid>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Inline error -->
          <Border Padding="10,8"
                  CornerRadius="4"
                  Background="#1EDC2626"
                  BorderThickness="1"
                  BorderBrush="#55DC2626"
                  IsVisible="{Binding HasInlineError, Mode=OneWay}">
            <Grid ColumnDefinitions="Auto,*">
              <Path Grid.Column="0" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,8,0" Data="{StaticResource Icons.Error}" Fill="OrangeRed"/>
              <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding InlineErrorMessage, Mode=OneWay}"/>
            </Grid>
          </Border>
        </StackPanel>

        <!-- Step-by-Step Result, Unmerged Follow-up Force Step & Backup Recovery View -->
        <StackPanel Orientation="Vertical"
                    Spacing="8"
                    IsVisible="{Binding HasResultView, Mode=OneWay}">
          <Border Padding="10,6"
                  CornerRadius="4"
                  Background="#1EFF8C00"
                  BorderThickness="1"
                  BorderBrush="#55FF8C00">
            <Grid ColumnDefinitions="Auto,*">
              <Path Grid.Column="0" Width="15" Height="15" VerticalAlignment="Top" Margin="0,2,8,0" Data="{StaticResource Icons.Error}" Fill="DarkOrange"/>
              <TextBlock Grid.Column="1" Classes="bold" TextWrapping="Wrap" Text="{Binding ResultSummary, Mode=OneWay}"/>
            </Grid>
          </Border>

          <Border Padding="8,6"
                  CornerRadius="4"
                  Background="{DynamicResource Brush.Contents}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource Brush.Border1}">
            <ItemsControl ItemsSource="{Binding StepResults}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:WorktreeDeleteStepDisplayItem">
                  <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                    <Path Grid.Column="0"
                          Width="14" Height="14"
                          Margin="0,2,8,0"
                          VerticalAlignment="Top"
                          Data="{Binding IconKey, Converter={x:Static v:DeleteBranch.StepIconConverter}}"
                          Fill="{Binding IconBrush}"/>
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock TextWrapping="Wrap" Text="{Binding Label}"/>
                      <TextBlock FontSize="11" Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" IsVisible="{Binding HasDetail}" Text="{Binding Detail}"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <!-- Remaining Unmerged Local Branch Follow-up Option -->
          <Border Padding="10,6"
                  CornerRadius="4"
                  Background="#1EFF8C00"
                  BorderThickness="1"
                  BorderBrush="#55FF8C00"
                  IsVisible="{Binding RequiresFollowUpForceLocalBranch, Mode=OneWay}">
            <StackPanel Spacing="4">
              <TextBlock Classes="bold" TextWrapping="Wrap" Text="{Binding FollowUpUnmergedHeader, Mode=OneWay}"/>
              <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding UnmergedCommits}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="m:UnmergedCommitSummary">
                      <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                        <TextBlock Grid.Column="0" FontFamily="{DynamicResource Fonts.Monospace}" FontSize="11" Margin="0,0,8,0" Foreground="{DynamicResource Brush.FG2}" Text="{Binding ShortSha}"/>
                        <TextBlock Grid.Column="1" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding Subject}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBlock FontSize="11" TextWrapping="Wrap" Text="{DynamicResource Text.RemoveWorktree.FollowUpKeepOrForceHint}"/>
              <Button Classes="flat primary"
                      Height="28"
                      HorizontalAlignment="Left"
                      Padding="12,0"
                      IsEnabled="{Binding !IsExecutingFollowUp, Mode=OneWay}"
                      Content="{DynamicResource Text.RemoveWorktree.ForceDeleteRemainingBranchBtn}"
                      Click="OnForceDeleteRemainingBranch"/>
            </StackPanel>
          </Border>

          <!-- Restore deleted local branch on Step 3 partial failure -->
          <Border Padding="10,8"
                  CornerRadius="4"
                  Background="{DynamicResource Brush.Contents}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource Brush.Border1}"
                  IsVisible="{Binding CanRestoreBackupBranch, Mode=OneWay}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="{DynamicResource Text.DeleteBranch.RestoringTargetLabel}"/>
              <TextBox Grid.Column="1" Height="28" VerticalAlignment="Center" Text="{Binding RestorableBranchName, Mode=TwoWay}"/>
              <Button Grid.Column="2"
                      Classes="flat primary"
                      Height="28"
                      Margin="8,0,0,0"
                      Padding="12,0"
                      IsEnabled="{Binding !IsRestoringBackup, Mode=OneWay}"
                      Content="{DynamicResource Text.DeleteBranch.RestoreLocalBtn}"
                      Click="OnRestoreBackupBranch"/>
            </Grid>
          </Border>

          <Border Padding="10,8"
                  CornerRadius="4"
                  Background="#1E16A34A"
                  BorderThickness="1"
                  BorderBrush="#4416A34A"
                  IsVisible="{Binding HasRestoreFeedback, Mode=OneWay}">
            <TextBlock TextWrapping="Wrap" Text="{Binding RestoreFeedbackMessage, Mode=OneWay}"/>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </StackPanel>
</UserControl>

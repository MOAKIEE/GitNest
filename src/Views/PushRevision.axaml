<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="360"
             x:Class="SourceGit.Views.PushRevision"
             x:DataType="vm:PushRevision"
             MaxWidth="600">
  <StackPanel Orientation="Vertical" Margin="8,0" Spacing="10">
    <StackPanel Orientation="Horizontal">
      <Path Width="16" Height="16"
            Data="{StaticResource Icons.Push}"/>

      <TextBlock FontSize="18"
                 Margin="8,0,0,0"
                 Classes="bold"
                 Text="{DynamicResource Text.Push.Revision.Title}"/>
    </StackPanel>

    <Grid Margin="0,6,0,0" RowDefinitions="32,32,Auto" ColumnDefinitions="120,*">
      <TextBlock Grid.Row="0" Grid.Column="0"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,8,0"
                 Text="{DynamicResource Text.Push.Revision}"/>
      <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="Auto,Auto,*">
        <Path Grid.Column="0" Width="14" Height="14" Data="{StaticResource Icons.Commit}"/>
        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   FontFamily="{DynamicResource Fonts.Monospace}"
                   Text="{Binding Revision.SHA, Converter={x:Static c:StringConverters.ToShortSHA}}"
                   Foreground="DarkOrange"
                   Margin="8,0,0,0"/>
        <TextBlock Grid.Column="2"
                   VerticalAlignment="Center"
                   Text="{Binding Revision.Subject}"
                   Margin="4,0,0,0"
                   TextTrimming="CharacterEllipsis"/>
      </Grid>

      <TextBlock Grid.Row="1" Grid.Column="0"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,8,0"
                 Text="{DynamicResource Text.Push.To}"/>
      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
        <Path Width="14" Height="14" Data="{StaticResource Icons.Branch}"/>
        <TextBlock VerticalAlignment="Center" Text="{Binding RemoteBranch.FriendlyName}" Margin="8,0,0,0"/>
      </StackPanel>

      <CheckBox Grid.Row="2" Grid.Column="1"
                Margin="0,6,0,0"
                Content="{DynamicResource Text.Push.Force}"
                IsChecked="{Binding Force, Mode=TwoWay}"/>
    </Grid>

    <Border Padding="10,8"
            CornerRadius="4"
            Background="#14D97706"
            BorderThickness="1"
            BorderBrush="#55D97706"
            IsVisible="{Binding ShowForceDetails, Mode=OneWay}">
      <StackPanel Spacing="4">
        <TextBlock FontSize="11" TextWrapping="Wrap" Text="{DynamicResource Text.Push.Revision.ForceLeaseWarning}"/>
        <TextBlock FontSize="11"
                   FontFamily="{DynamicResource Fonts.Monospace}"
                   Foreground="{DynamicResource Brush.FG2}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasRemoteTipDisplay, Mode=OneWay}"
                   Text="{Binding RemoteTipDisplay, Mode=OneWay}"/>
      </StackPanel>
    </Border>

    <Border Padding="10,8"
            CornerRadius="4"
            Background="#1EDC2626"
            BorderThickness="1"
            BorderBrush="#55DC2626"
            IsVisible="{Binding HasForceBlockMessage, Mode=OneWay}">
      <Grid ColumnDefinitions="Auto,*">
        <Path Grid.Column="0" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,8,0" Data="{StaticResource Icons.Error}" Fill="OrangeRed"/>
        <TextBlock Grid.Column="1" FontSize="11" TextWrapping="Wrap" Text="{Binding ForceBlockMessage, Mode=OneWay}"/>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>

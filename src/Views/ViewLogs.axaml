<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:vm="using:SourceGit.ViewModels"
                    xmlns:v="using:SourceGit.Views"
                    xmlns:c="using:SourceGit.Converters"
                    mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="600"
                    x:Class="SourceGit.Views.ViewLogs"
                    x:DataType="vm:ViewLogs"
                    x:Name="ThisControl"
                    Title="{DynamicResource Text.ViewLogs}"
                    Icon="/App.ico"
                    Width="920" Height="600"
                    MinWidth="740" MinHeight="480"
                    CanResize="True"
                    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*">
    <!-- TitleBar -->
    <Grid Grid.Row="0" Height="28" IsVisible="{Binding !#ThisControl.UseSystemWindowFrame}">
      <Border Background="{DynamicResource Brush.TitleBar}"
              BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}"
              PointerPressed="BeginMoveWindow"/>

      <Path Width="14" Height="14"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            Data="{StaticResource Icons.Logs}"
            IsVisible="{OnPlatform True, macOS=False}"/>

      <TextBlock Classes="bold"
                 Text="{DynamicResource Text.ViewLogs}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False"/>

      <v:CaptionButtons HorizontalAlignment="Right"
                        IsCloseButtonOnly="True"
                        IsVisible="{OnPlatform True, macOS=False}"/>
    </Grid>

    <!-- Tab Bar & Header Actions -->
    <Border Grid.Row="1"
            Background="{DynamicResource Brush.SubPanel}"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource Brush.Border0}"
            Padding="8,6">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Grid.Column="0"
                Background="{DynamicResource Brush.Contents}"
                BorderBrush="{DynamicResource Brush.Border2}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="2">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Classes="flat"
                    Classes.primary="{Binding IsOperationsTabActive, Mode=OneWay}"
                    Height="26"
                    Padding="12,0"
                    FontSize="12"
                    Content="{DynamicResource Text.ViewLogs.TabOperations}"
                    Click="OnSelectOperationsTab"/>
            <Button Classes="flat"
                    Classes.primary="{Binding IsRawLogsTabActive, Mode=OneWay}"
                    Height="26"
                    Padding="12,0"
                    FontSize="12"
                    Content="{DynamicResource Text.ViewLogs.TabCommandLogs}"
                    Click="OnSelectRawLogsTab"/>
            <Button Classes="flat"
                    Classes.primary="{Binding IsDiscardBackupsTabActive, Mode=OneWay}"
                    Height="26"
                    Padding="12,0"
                    FontSize="12"
                    Content="{DynamicResource Text.ViewLogs.TabDiscardBackups}"
                    Click="OnSelectDiscardBackupsTab"/>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="12,0"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsOperationsTabActive, Mode=OneWay}">
          <TextBlock FontSize="12"
                     Foreground="{DynamicResource Brush.FG1}"
                     Text="{Binding RepoStateSummary, Mode=OneWay}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center"/>
          <TextBlock FontSize="12"
                     Foreground="{DynamicResource Brush.FG2}"
                     Text="{Binding ActiveBackupsSummary, Mode=OneWay}"
                     VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="12,0"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsDiscardBackupsTabActive, Mode=OneWay}">
          <TextBlock FontSize="12"
                     Foreground="{DynamicResource Brush.FG1}"
                     Text="{Binding DiscardBackupsSummary, Mode=OneWay}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsOperationsTabActive, Mode=OneWay}">
          <Button Classes="flat"
                  Height="28"
                  Padding="10,0"
                  FontSize="12"
                  Content="{DynamicResource Text.OperationRecovery.ReconcileAll}"
                  IsEnabled="{Binding !IsBusy, Mode=OneWay}"
                  Click="OnReconcileAllOperations"/>
          <Button Classes="flat"
                  Height="28"
                  Padding="10,0"
                  FontSize="12"
                  Content="{DynamicResource Text.OperationRecovery.PreviewExpiredBackups}"
                  IsEnabled="{Binding !IsBusy, Mode=OneWay}"
                  Click="OnPreviewExpiredBackups"/>
        </StackPanel>

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsDiscardBackupsTabActive, Mode=OneWay}">
          <Button Classes="flat"
                  Height="28"
                  Padding="10,0"
                  FontSize="12"
                  Content="{DynamicResource Text.Repository.RefreshStatus}"
                  IsEnabled="{Binding !IsBusy, Mode=OneWay}"
                  Click="OnRefreshDiscardBackups"/>
          <Button Classes="flat"
                  Height="28"
                  Padding="10,0"
                  FontSize="12"
                  Content="{DynamicResource Text.ViewLogs.DiscardBackups.PruneExpired}"
                  IsEnabled="{Binding CanPruneExpiredDiscardBackups, Mode=OneWay}"
                  Click="OnPruneExpiredDiscardBackups"/>
        </StackPanel>

        <Button Grid.Column="2"
                Classes="flat primary"
                Height="28"
                Padding="12,0"
                FontSize="12"
                Content="{DynamicResource Text.ViewLogs.Clear}"
                IsVisible="{Binding IsRawLogsTabActive, Mode=OneWay}"
                IsEnabled="{Binding Logs.Count, Converter={x:Static c:IntConverters.IsGreaterThanZero}}"
                Click="OnClearAllLogs"/>
      </Grid>
    </Border>

    <!-- Tab 0: Operations & Recovery -->
    <Grid Grid.Row="2"
          Margin="8"
          RowDefinitions="Auto,Auto,*"
          IsVisible="{Binding IsOperationsTabActive, Mode=OneWay}">
      <!-- Feedback Banner -->
      <Border Grid.Row="0"
              Margin="0,0,0,8"
              Padding="10,6"
              CornerRadius="4"
              BorderThickness="1"
              Background="{DynamicResource Brush.Window}"
              BorderBrush="{DynamicResource Brush.Border2}"
              IsVisible="{Binding HasFeedbackMessage, Mode=OneWay}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Path Grid.Column="0"
                Width="14" Height="14"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Fill="{DynamicResource Brush.Accent}"
                Data="{StaticResource Icons.CheckCircled}"
                IsVisible="{Binding !IsFeedbackError, Mode=OneWay}"/>
          <Path Grid.Column="0"
                Width="14" Height="14"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Fill="{DynamicResource Brush.Conflict}"
                Data="{StaticResource Icons.Error}"
                IsVisible="{Binding IsFeedbackError, Mode=OneWay}"/>
          <TextBlock Grid.Column="1"
                     FontSize="12"
                     VerticalAlignment="Center"
                     Text="{Binding FeedbackMessage, Mode=OneWay}"
                     TextWrapping="Wrap"/>
          <Button Grid.Column="2"
                  Classes="flat"
                  Height="24"
                  Padding="8,0"
                  Margin="8,0,0,0"
                  FontSize="11"
                  Content="{DynamicResource Text.WorkingCopy.DismissBanner}"
                  Click="OnDismissFeedback"/>
        </Grid>
      </Border>

      <!-- Expired Backup Prune Confirmation Panel -->
      <Border Grid.Row="1"
              Margin="0,0,0,8"
              Padding="10,8"
              CornerRadius="4"
              BorderThickness="1"
              Background="#1EFF8C00"
              BorderBrush="{DynamicResource Brush.Border2}"
              IsVisible="{Binding HasExpiredBackupsToPrune, Mode=OneWay}">
        <StackPanel Orientation="Vertical" Spacing="6">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Path Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0" Fill="DarkOrange" Data="{StaticResource Icons.Clean}"/>
            <TextBlock Grid.Column="1" Classes="bold" FontSize="12" Text="{DynamicResource Text.OperationRecovery.PrunePanelTitle}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" FontSize="11" Foreground="{DynamicResource Brush.FG2}" Text="{Binding PrunePreviewSummary, Mode=OneWay}" VerticalAlignment="Center"/>
          </Grid>
          <TextBox IsReadOnly="True"
                   AcceptsReturn="True"
                   FontFamily="{DynamicResource Fonts.Monospace}"
                   FontSize="11"
                   MaxHeight="90"
                   Text="{Binding PruneExpiredListText, Mode=OneWay}"/>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Classes="flat primary"
                    Height="26" Padding="10,0" FontSize="12"
                    Content="{DynamicResource Text.OperationRecovery.PruneConfirmBtn}"
                    IsEnabled="{Binding !IsBusy, Mode=OneWay}"
                    Click="OnConfirmPruneExpiredBackups"/>
            <Button Classes="flat"
                    Height="26" Padding="10,0" FontSize="12"
                    Content="{DynamicResource Text.OperationRecovery.PruneCancelBtn}"
                    IsEnabled="{Binding !IsBusy, Mode=OneWay}"
                    Click="OnCancelPrunePreview"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Operations Split View -->
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="315" MinWidth="250" MaxWidth="460"/>
          <ColumnDefinition Width="4"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ListBox Grid.Column="0"
                 Padding="4"
                 Background="{DynamicResource Brush.Contents}"
                 BorderThickness="1"
                 BorderBrush="{DynamicResource Brush.Border2}"
                 ItemsSource="{Binding Operations}"
                 SelectedItem="{Binding SelectedOperation, Mode=TwoWay}"
                 SelectionMode="Single"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Margin" Value="0,1"/>
              <Setter Property="Padding" Value="8,6"/>
              <Setter Property="MinHeight" Value="52"/>
              <Setter Property="CornerRadius" Value="4"/>
            </Style>
          </ListBox.Styles>

          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:OperationJournalEntryItem">
              <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="18,*,Auto">
                <Path Grid.Row="0" Grid.Column="0" Width="13" Height="13" VerticalAlignment="Center"
                      Fill="{DynamicResource Brush.Accent}"
                      Data="{StaticResource Icons.CheckCircled}"
                      IsVisible="{Binding IsSuccess, Mode=OneWay}"/>
                <Path Grid.Row="0" Grid.Column="0" Width="13" Height="13" VerticalAlignment="Center"
                      Fill="{DynamicResource Brush.Conflict}"
                      Data="{StaticResource Icons.Error}"
                      IsVisible="{Binding IsFailure, Mode=OneWay}"/>
                <Path Grid.Row="0" Grid.Column="0" Width="13" Height="13" VerticalAlignment="Center"
                      Fill="DarkOrange"
                      Data="{StaticResource Icons.Info}"
                      IsVisible="{Binding IsWarningIcon, Mode=OneWay}"/>

                <TextBlock Grid.Row="0" Grid.Column="1"
                           Margin="4,0,6,0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="{Binding Title, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="0" Grid.Column="2"
                           FontSize="11"
                           Foreground="{DynamicResource Brush.FG2}"
                           Text="{Binding TimeDisplay, Mode=OneWay}"
                           VerticalAlignment="Center"/>

                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="4,3,0,0" ColumnDefinitions="Auto,*">
                  <TextBlock Grid.Column="0"
                             FontSize="11"
                             Foreground="{DynamicResource Brush.FG2}"
                             Text="{Binding StageText, Mode=OneWay}"/>
                  <TextBlock Grid.Column="1"
                             Margin="8,0,0,0"
                             FontSize="11"
                             Foreground="{DynamicResource Brush.FG2}"
                             Text="{Binding BranchDisplay, Mode=OneWay}"
                             TextTrimming="CharacterEllipsis"
                             HorizontalAlignment="Right"/>
                </Grid>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Column="0"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="8"
                    Margin="16"
                    IsVisible="{Binding Operations.Count, Converter={x:Static c:IntConverters.IsZero}}">
          <Path HorizontalAlignment="Center"
                Width="40" Height="40"
                Data="{StaticResource Icons.Empty}"
                Fill="{DynamicResource Brush.FG2}"/>
          <TextBlock HorizontalAlignment="Center"
                     FontSize="12"
                     Foreground="{DynamicResource Brush.FG2}"
                     Text="{DynamicResource Text.OperationRecovery.EmptyOperations}"
                     TextWrapping="Wrap"
                     TextAlignment="Center"/>
        </StackPanel>

        <GridSplitter Grid.Column="1"
                      MinWidth="1"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent"
                      BorderThickness="0"
                      Focusable="False"/>

        <Border Grid.Column="2"
                BorderBrush="{DynamicResource Brush.Border2}"
                BorderThickness="1"
                Background="{DynamicResource Brush.Contents}">
          <ScrollViewer x:Name="OperationDetailsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14" Spacing="10" IsVisible="{Binding HasSelectedOperation, Mode=OneWay}">
              <!-- Operation Title & Status -->
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           FontSize="15"
                           FontWeight="Bold"
                           Text="{Binding SelectedOperation?.Title, Mode=OneWay}"
                           TextWrapping="Wrap"/>
                <Border Grid.Column="1"
                        Padding="8,3"
                        CornerRadius="4"
                        Background="{DynamicResource Brush.SubPanel}"
                        BorderBrush="{DynamicResource Brush.Border2}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                  <TextBlock FontSize="11"
                             FontWeight="SemiBold"
                             Text="{Binding SelectedOperation?.StageText, Mode=OneWay}"/>
                </Border>
              </Grid>

              <!-- Structured Operation Metadata -->
              <Border Background="{DynamicResource Brush.Window}"
                      BorderBrush="{DynamicResource Brush.Border2}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="10,8">
                <StackPanel Spacing="5">
                  <Grid ColumnDefinitions="120,*">
                    <TextBlock Grid.Column="0" FontSize="12" Foreground="{DynamicResource Brush.FG2}" Text="{DynamicResource Text.OperationRecovery.OperationId}"/>
                    <SelectableTextBlock Grid.Column="1" FontSize="12" FontFamily="{DynamicResource Fonts.Monospace}" Text="{Binding SelectedOperation?.OperationId, Mode=OneWay}"/>
                  </Grid>
                  <Grid ColumnDefinitions="120,*">
                    <TextBlock Grid.Column="0" FontSize="12" Foreground="{DynamicResource Brush.FG2}" Text="{DynamicResource Text.OperationRecovery.TimeLabel}"/>
                    <SelectableTextBlock Grid.Column="1" FontSize="12" Text="{Binding SelectedOperation?.FullTimeDisplay, Mode=OneWay}"/>
                  </Grid>
                  <Grid ColumnDefinitions="120,*">
                    <TextBlock Grid.Column="0" FontSize="12" Foreground="{DynamicResource Brush.FG2}" Text="{DynamicResource Text.OperationRecovery.BranchLabel}"/>
                    <SelectableTextBlock Grid.Column="1" FontSize="12" Text="{Binding SelectedOperation?.BranchDisplay, Mode=OneWay}"/>
                  </Grid>
                  <Grid ColumnDefinitions="120,*">
                    <TextBlock Grid.Column="0" FontSize="12" Foreground="{DynamicResource Brush.FG2}" Text="{DynamicResource Text.OperationRecovery.RemoteLabel}"/>
                    <SelectableTextBlock Grid.Column="1" FontSize="12" Text="{Binding SelectedOperation?.RemoteDisplay, Mode=OneWay}"/>
                  </Grid>
                  <Grid ColumnDefinitions="120,*">
                    <TextBlock Grid.Column="0" FontSize="12" Foreground="{DynamicResource Brush.FG2}" Text="{DynamicResource Text.OperationRecovery.OriginalTip}"/>
                    <SelectableTextBlock Grid.Column="1" FontSize="12" FontFamily="{DynamicResource Fonts.Monospace}" Text="{Binding SelectedOperation?.OriginalTipDisplay, Mode=OneWay}"/>
                  </Grid>
                  <Grid ColumnDefinitions="120,*">
                    <TextBlock Grid.Column="0" FontSize="12" Foreground="{DynamicResource Brush.FG2}" Text="{DynamicResource Text.OperationRecovery.TargetTip}"/>
                    <SelectableTextBlock Grid.Column="1" FontSize="12" FontFamily="{DynamicResource Fonts.Monospace}" Text="{Binding SelectedOperation?.TargetTipDisplay, Mode=OneWay}"/>
                  </Grid>
                  <Grid ColumnDefinitions="120,*">
                    <TextBlock Grid.Column="0" FontSize="12" Foreground="{DynamicResource Brush.FG2}" Text="{DynamicResource Text.OperationRecovery.ExpectedRemoteTip}"/>
                    <SelectableTextBlock Grid.Column="1" FontSize="12" FontFamily="{DynamicResource Fonts.Monospace}" Text="{Binding SelectedOperation?.ExpectedRemoteTipDisplay, Mode=OneWay}"/>
                  </Grid>
                  <Grid ColumnDefinitions="120,*">
                    <TextBlock Grid.Column="0" FontSize="12" Foreground="{DynamicResource Brush.FG2}" Text="{DynamicResource Text.OperationRecovery.BackupRef}"/>
                    <SelectableTextBlock Grid.Column="1" FontSize="12" FontFamily="{DynamicResource Fonts.Monospace}" Text="{Binding SelectedOperation?.BackupRefDisplay, Mode=OneWay}" TextWrapping="Wrap"/>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Summary & Disk Truth Reconciliation -->
              <Border Background="{DynamicResource Brush.Window}"
                      BorderBrush="{DynamicResource Brush.Border2}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="10,8">
                <StackPanel Spacing="6">
                  <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.FG2}" Text="{DynamicResource Text.OperationRecovery.SummaryLabel}"/>
                  <SelectableTextBlock FontSize="12" Text="{Binding SelectedOperation?.StepSummary, Mode=OneWay}" TextWrapping="Wrap"/>

                  <StackPanel Spacing="4" Margin="0,4,0,0" IsVisible="{Binding HasSelectedReconciliationNote, Mode=OneWay}">
                    <Border Height="1" Background="{DynamicResource Brush.Border2}" Margin="0,2"/>
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="DarkOrange" Text="{DynamicResource Text.OperationRecovery.ReconciliationLabel}"/>
                    <SelectableTextBlock FontSize="12" Text="{Binding SelectedOperation?.ReconciliationNote, Mode=OneWay}" TextWrapping="Wrap"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- Recovery Action Bar -->
              <WrapPanel Orientation="Horizontal">
                <Button Classes="flat primary"
                        Height="28" Padding="12,0" Margin="0,0,8,6" FontSize="12"
                        Content="{DynamicResource Text.OperationRecovery.VerifySelected}"
                        IsEnabled="{Binding !IsBusy, Mode=OneWay}"
                        Click="OnVerifySelectedOperation"/>
                <Button Classes="flat"
                        Height="28" Padding="12,0" Margin="0,0,8,6" FontSize="12"
                        Content="{DynamicResource Text.OperationRecovery.VerifyRemoteSelected}"
                        IsVisible="{Binding CanVerifyRemoteSelectedOperation, Mode=OneWay}"
                        IsEnabled="{Binding !IsBusy, Mode=OneWay}"
                        Click="OnVerifyRemoteSelectedOperation"/>
                <Button Classes="flat"
                        Height="28" Padding="12,0" Margin="0,0,8,6" FontSize="12"
                        Content="{DynamicResource Text.OperationRecovery.AcknowledgeSelected}"
                        IsVisible="{Binding CanAcknowledgeSelectedOperation, Mode=OneWay}"
                        IsEnabled="{Binding CanAcknowledgeSelectedOperation, Mode=OneWay}"
                        Click="OnAcknowledgeSelectedOperation"/>
              </WrapPanel>

              <!-- Restore Branch From Local Backup Ref -->
              <Border Background="{DynamicResource Brush.SubPanel}"
                      BorderBrush="{DynamicResource Brush.Border2}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="10,8"
                      IsVisible="{Binding SelectedOperation?.HasBackupRef, Mode=OneWay, FallbackValue=False}">
                <StackPanel Spacing="8">
                  <StackPanel Spacing="6" IsVisible="{Binding IsSelectedResetBackup, Mode=OneWay}">
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource Brush.FG2}"
                               Text="{DynamicResource Text.OperationRecovery.InspectingBackup}"
                               IsVisible="{Binding IsInspectingResetBackup, Mode=OneWay}"/>

                    <RadioButton GroupName="GitNestBackupRestoreMode"
                                 FontSize="12"
                                 IsChecked="{Binding RestoreModeNewBranch, Mode=TwoWay}">
                      <TextBlock TextWrapping="Wrap" Text="{DynamicResource Text.OperationRecovery.RestoreModeNewBranch}"/>
                    </RadioButton>

                    <RadioButton GroupName="GitNestBackupRestoreMode"
                                 FontSize="12"
                                 IsChecked="{Binding RestoreModeExistingBranch, Mode=TwoWay}"
                                 IsEnabled="{Binding CanSelectRestoreExistingBranch, Mode=OneWay}">
                      <TextBlock TextWrapping="Wrap" Text="{DynamicResource Text.OperationRecovery.RestoreModeExistingBranch}"/>
                    </RadioButton>

                    <Border Padding="8,5"
                            CornerRadius="3"
                            Background="#1ED97706"
                            BorderThickness="1"
                            BorderBrush="#55D97706"
                            IsVisible="{Binding HasRestoreNewerCommitsWarning, Mode=OneWay}">
                      <TextBlock FontSize="11" Foreground="DarkOrange" TextWrapping="Wrap" Text="{Binding RestoreNewerCommitsWarningText, Mode=OneWay}"/>
                    </Border>

                    <Border Padding="8,5"
                            CornerRadius="3"
                            Background="#1EDC2626"
                            BorderThickness="1"
                            BorderBrush="#55DC2626"
                            IsVisible="{Binding HasResetBackupBlockReason, Mode=OneWay}">
                      <TextBlock FontSize="11" TextWrapping="Wrap" Text="{Binding ResetBackupBlockReason, Mode=OneWay}"/>
                    </Border>
                  </StackPanel>

                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             Height="28"
                             Margin="0,0,8,0"
                             FontSize="12"
                             IsReadOnly="{Binding RestoreModeExistingBranch, Mode=OneWay}"
                             Watermark="{DynamicResource Text.OperationRecovery.RestoreBranchWatermark}"
                             Text="{Binding RestoreTargetBranch, Mode=TwoWay}"/>
                    <Button Grid.Column="1"
                            Classes="flat primary"
                            Height="28" Padding="12,0" FontSize="12"
                            Content="{DynamicResource Text.OperationRecovery.RestoreBackupBtn}"
                            IsEnabled="{Binding CanRestoreSelectedBackup, Mode=OneWay}"
                            Click="OnRestoreSelectedBackup"/>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Expandable Redacted Command & Diagnostic Details -->
              <Expander HorizontalAlignment="Stretch"
                        IsExpanded="False"
                        IsVisible="{Binding HasSelectedDiagnostics, Mode=OneWay}">
                <Expander.Header>
                  <TextBlock FontSize="12" Text="{DynamicResource Text.OperationRecovery.DiagnosticsExpander}"/>
                </Expander.Header>
                <StackPanel Spacing="6" Margin="0,6,0,0">
                  <TextBox IsReadOnly="True"
                           AcceptsReturn="True"
                           FontFamily="{DynamicResource Fonts.Monospace}"
                           FontSize="11"
                           MaxHeight="170"
                           Text="{Binding SelectedOperationDiagnosticText, Mode=OneWay}"/>
                  <Button Classes="flat"
                          Height="26" Padding="10,0" FontSize="11"
                          HorizontalAlignment="Left"
                          Content="{DynamicResource Text.OperationRecovery.CopyCommandDetails}"
                          Click="OnCopySelectedDiagnostics"/>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>

    <!-- Tab 1: Raw Command Logs -->
    <Grid Grid.Row="2" Margin="8" IsVisible="{Binding IsRawLogsTabActive, Mode=OneWay}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" MaxWidth="500" MinWidth="250"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <ListBox Grid.Column="0"
               Padding="4"
               Background="{DynamicResource Brush.Contents}"
               BorderThickness="1"
               BorderBrush="{DynamicResource Brush.Border2}"
               ItemsSource="{Binding Logs}"
               SelectedItem="{Binding SelectedLog, Mode=TwoWay}"
               SelectionMode="Single"
               KeyDown="OnLogKeyDown"
               Grid.IsSharedSizeScope="True"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="4"/>
          </Style>
        </ListBox.Styles>

        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel Orientation="Vertical"/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>

        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:CommandLog">
            <Grid Background="Transparent" ContextRequested="OnLogContextRequested">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="StartTimeColumn"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="DurationColumn"/>
              </Grid.ColumnDefinitions>

              <v:LoadingIcon Grid.Column="0"
                             Width="14" Height="14"
                             Margin="4,0,4,0"
                             IsVisible="{Binding !IsComplete}"/>

              <TextBlock Grid.Column="1"
                         Margin="4,0,0,0"
                         Text="{Binding Name}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"/>

              <TextBlock Grid.Column="2"
                         Margin="4,0"
                         Foreground="{DynamicResource Brush.FG2}"
                         Text="{Binding StartTime, StringFormat=HH:mm:ss}"/>

              <v:CommandLogTime Grid.Column="3"
                                Margin="4,0"
                                Foreground="{DynamicResource Brush.FG2}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Path Grid.Column="0"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Width="48" Height="48"
            Data="{StaticResource Icons.Empty}"
            Fill="{DynamicResource Brush.FG2}"
            IsVisible="{Binding Logs.Count, Converter={x:Static c:IntConverters.IsZero}}"/>

      <GridSplitter Grid.Column="1"
                    MinWidth="1"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Focusable="False"/>

      <Border Grid.Column="2"
              BorderBrush="{DynamicResource Brush.Border2}"
              BorderThickness="1"
              Background="{DynamicResource Brush.Contents}">
        <v:CommandLogContentPresenter Log="{Binding SelectedLog}"
                                      FontFamily="{DynamicResource Fonts.Monospace}"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"/>
      </Border>
    </Grid>

    <!-- Tab 2: 30-Day Discard Backups -->
    <Grid Grid.Row="2"
          Margin="8"
          RowDefinitions="Auto,*"
          IsVisible="{Binding IsDiscardBackupsTabActive, Mode=OneWay}">
      <!-- Feedback Banner -->
      <Border Grid.Row="0"
              Margin="0,0,0,8"
              Padding="10,8"
              CornerRadius="4"
              BorderThickness="1"
              Background="{DynamicResource Brush.Window}"
              BorderBrush="{DynamicResource Brush.Border1}"
              IsVisible="{Binding HasFeedbackMessage, Mode=OneWay}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Path Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0"
                Data="{StaticResource Icons.Error}" Fill="#E05252"
                IsVisible="{Binding IsFeedbackError, Mode=OneWay}"/>
          <Path Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0"
                Data="{StaticResource Icons.Info}"
                IsVisible="{Binding !IsFeedbackError, Mode=OneWay}"/>
          <TextBlock Grid.Column="1" FontSize="12" Text="{Binding FeedbackMessage, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center"/>
          <Button Grid.Column="2" Classes="icon_button" Width="22" Height="22" Margin="8,0,0,0" Click="OnDismissFeedback">
            <Path Width="10" Height="10" Data="{StaticResource Icons.Window.Close}"/>
          </Button>
        </Grid>
      </Border>

      <!-- Master/Detail Backups View -->
      <Grid Grid.Row="1" ColumnDefinitions="300,6,*">
        <Border Grid.Column="0"
                BorderBrush="{DynamicResource Brush.Border2}"
                BorderThickness="1"
                Background="{DynamicResource Brush.Contents}">
          <Grid>
            <ListBox ItemsSource="{Binding DiscardBackups}"
                     SelectedItem="{Binding SelectedDiscardBackup, Mode=TwoWay}"
                     SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Margin" Value="0"/>
                  <Setter Property="Padding" Value="8,6"/>
                  <Setter Property="Height" Value="NaN"/>
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:DiscardBackupItemViewModel">
                  <StackPanel Orientation="Vertical" Spacing="3">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0"
                                 FontSize="12.5"
                                 FontWeight="Bold"
                                 Text="{Binding BaselineLabel}"
                                 TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="1"
                                 FontSize="11"
                                 FontFamily="{DynamicResource Fonts.Monospace}"
                                 Foreground="{DynamicResource Brush.FG2}"
                                 Text="{Binding TimeDisplay}"/>
                    </Grid>
                    <TextBlock FontSize="11.5"
                               Text="{Binding Summary}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.FG2}"/>
                    <WrapPanel Orientation="Horizontal">
                      <TextBlock Margin="0,2,6,0" FontSize="11" FontFamily="{DynamicResource Fonts.Monospace}" Foreground="{DynamicResource Brush.FG2}" VerticalAlignment="Center" Text="{Binding ShortId}"/>
                      <TextBlock Margin="0,2,6,0" FontSize="11" Foreground="{DynamicResource Brush.FG2}" VerticalAlignment="Center" Text="{Binding FileCountText}"/>
                      <Border Margin="0,2,6,0" Padding="5,1" CornerRadius="3" Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="1">
                        <TextBlock FontSize="10.5" Text="{Binding ExpiryBadgeText}"/>
                      </Border>
                      <Border Margin="0,2,0,0" Padding="5,1" CornerRadius="3" Background="{DynamicResource Brush.Window}" BorderBrush="#662DA44E" BorderThickness="1" IsVisible="{Binding IsRestored}">
                        <TextBlock FontSize="10.5" Foreground="#2DA44E" FontWeight="SemiBold" Text="{Binding RestoredDisplay}"/>
                      </Border>
                    </WrapPanel>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        IsVisible="{Binding DiscardBackups.Count, Converter={x:Static c:IntConverters.IsZero}}">
              <Path HorizontalAlignment="Center" Width="40" Height="40" Data="{StaticResource Icons.Archive}" Fill="{DynamicResource Brush.FG2}"/>
              <TextBlock FontSize="12" Foreground="{DynamicResource Brush.FG2}" Text="{DynamicResource Text.ViewLogs.DiscardBackups.Empty}"/>
            </StackPanel>
          </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                      MinWidth="1"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent"
                      BorderThickness="0"
                      Focusable="False"/>

        <Border Grid.Column="2"
                BorderBrush="{DynamicResource Brush.Border2}"
                BorderThickness="1"
                Background="{DynamicResource Brush.Contents}"
                Padding="12">
          <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding HasSelectedDiscardBackup, Mode=OneWay}">
              <StackPanel Orientation="Vertical" Spacing="10">
                <!-- Header Metadata -->
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="2">
                    <TextBlock FontSize="14" FontWeight="Bold" Text="{Binding SelectedDiscardBaselineLabel, Mode=OneWay}"/>
                    <TextBlock FontSize="11.5"
                               Foreground="{DynamicResource Brush.FG2}"
                               FontFamily="{DynamicResource Fonts.Monospace}"
                               Text="{Binding SelectedDiscardMetaLine, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>

                  <Button Grid.Column="1"
                          Classes="flat"
                          Height="28"
                          Padding="10,0"
                          Margin="8,0,0,0"
                          FontSize="12"
                          Content="{DynamicResource Text.ViewLogs.Delete}"
                          IsEnabled="{Binding CanDeleteSelectedDiscardBackup, Mode=OneWay}"
                          Click="OnDeleteSelectedDiscardBackup"/>

                  <Button Grid.Column="2"
                          Classes="flat primary"
                          Height="28"
                          Padding="12,0"
                          Margin="8,0,0,0"
                          FontSize="12"
                          Content="{DynamicResource Text.ViewLogs.DiscardBackups.Restore}"
                          IsEnabled="{Binding CanRestoreSelectedDiscardBackup, Mode=OneWay}"
                          Click="OnRestoreSelectedDiscardBackup"/>
                </Grid>

                <!-- Preflight Blocking Error (Expired / Corrupt Payload) -->
                <Border Background="#1AE05252"
                        BorderBrush="#66E05252"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,8"
                        IsVisible="{Binding HasSelectedDiscardBlockingError, Mode=OneWay}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Width="14" Height="14" Data="{StaticResource Icons.Error}" Fill="#E05252" VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <TextBlock FontSize="12" Text="{Binding SelectedDiscardBlockingReason, Mode=OneWay}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <!-- Subsequent Modification Conflict Warning + Explicit Overwrite Opt-In -->
                <Border Background="#18D97706"
                        BorderBrush="#66D97706"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,8"
                        IsVisible="{Binding HasSelectedDiscardConflicts, Mode=OneWay}">
                  <StackPanel Orientation="Vertical" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Path Width="14" Height="14" Data="{StaticResource Icons.Info}" Fill="#D97706"/>
                      <TextBlock FontSize="12" FontWeight="Bold" Text="{DynamicResource Text.ViewLogs.DiscardBackups.ConflictTitle}"/>
                    </StackPanel>
                    <TextBlock FontSize="11.5" Text="{DynamicResource Text.ViewLogs.DiscardBackups.ConflictDesc}" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding SelectedDiscardConflictDetails}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="x:String">
                          <TextBlock FontSize="11.5" FontFamily="{DynamicResource Fonts.Monospace}" Text="{Binding}" TextWrapping="Wrap" Margin="0,1"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox Content="{DynamicResource Text.ViewLogs.DiscardBackups.ConfirmOverwrite}"
                              IsChecked="{Binding AllowOverwriteSubsequentEdits, Mode=TwoWay}"/>
                  </StackPanel>
                </Border>

                <!-- Files List -->
                <Border Background="{DynamicResource Brush.Window}"
                        BorderBrush="{DynamicResource Brush.Border2}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,8">
                  <StackPanel Orientation="Vertical" Spacing="6">
                    <TextBlock FontSize="12" FontWeight="Bold" Text="{DynamicResource Text.ViewLogs.DiscardBackups.FilesTitle}"/>
                    <ItemsControl ItemsSource="{Binding SelectedDiscardBackupFiles}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:DiscardBackupFileRow">
                          <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3">
                            <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="1" Margin="0,0,8,0">
                              <TextBlock FontSize="12" FontFamily="{DynamicResource Fonts.Monospace}" Text="{Binding RelativePath}" TextTrimming="CharacterEllipsis"/>
                              <TextBlock FontSize="11" Foreground="{DynamicResource Brush.FG2}" Text="{Binding PayloadSummary}"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Margin="0,0,6,0"
                                    Padding="5,1"
                                    CornerRadius="3"
                                    VerticalAlignment="Center"
                                    Background="#18D97706"
                                    BorderBrush="#66D97706"
                                    BorderThickness="1"
                                    IsVisible="{Binding HasSubsequentModification}">
                              <TextBlock FontSize="10.5" Text="{Binding ConflictBadge}"/>
                            </Border>
                            <Border Grid.Column="2"
                                    Padding="6,2"
                                    CornerRadius="3"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.Contents}"
                                    BorderBrush="{DynamicResource Brush.Border2}"
                                    BorderThickness="1">
                              <TextBlock FontSize="10.5" Text="{Binding StateLabel}"/>
                            </Border>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource Brush.FG2}"
                       Text="{DynamicResource Text.ViewLogs.DiscardBackups.SelectPrompt}"
                       IsVisible="{Binding !HasSelectedDiscardBackup, Mode=OneWay}"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</v:ChromelessWindow>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SourceGit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="530" d:DesignHeight="220"
             x:Class="SourceGit.Views.DropStash"
             x:DataType="vm:DropStash">
  <StackPanel Orientation="Vertical" Margin="8,0" Spacing="10">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Path Width="16" Height="16" Data="{StaticResource Icons.Stashes}"/>
      <TextBlock FontSize="18" FontWeight="Bold" Classes="bold" Text="{DynamicResource Text.StashDropConfirm}"/>
    </StackPanel>

    <Border Background="{DynamicResource Brush.Contents}"
            BorderBrush="{DynamicResource Brush.Border1}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10,8">
      <StackPanel Orientation="Vertical" Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock FontFamily="{DynamicResource Fonts.Monospace}" FontWeight="Bold" Text="{Binding Stash.Name}"/>
          <TextBlock FontFamily="{DynamicResource Fonts.Monospace}" Foreground="{DynamicResource Brush.FG2}" Text="{Binding StashShortSha}"/>
          <Border Padding="5,1" CornerRadius="3" Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="1">
            <TextBlock FontSize="11" Text="{Binding SourceBranchDisplay}"/>
          </Border>
        </StackPanel>
        <TextBlock Text="{Binding Stash.DisplaySubject}" TextWrapping="Wrap"/>
        <TextBlock FontSize="11.5"
                   Foreground="{DynamicResource Brush.FG2}"
                   Text="{DynamicResource Text.DropStash.Tip}"
                   TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <Border Background="#1AE05252"
            BorderBrush="#66E05252"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10,8"
            IsVisible="{Binding HasResultView}">
      <StackPanel Orientation="Vertical" Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Width="14" Height="14" Data="{StaticResource Icons.Error}" Fill="#E05252"/>
          <TextBlock FontSize="12.5" FontWeight="Bold" Text="{DynamicResource Text.DropStash.FailedTitle}"/>
        </StackPanel>
        <TextBlock FontSize="12" Text="{Binding ResultSummary}" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>

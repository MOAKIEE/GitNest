<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
             x:Class="SourceGit.Views.Reset"
             x:DataType="vm:Reset"
             MaxWidth="640">
  <StackPanel Orientation="Vertical" Margin="8,0">
    <!-- Title -->
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Path Width="16" Height="16" Data="{StaticResource Icons.Reset}"/>
      <TextBlock FontSize="18" Classes="bold" Text="{DynamicResource Text.Reset}"/>
    </StackPanel>

    <ScrollViewer MaxHeight="520"
                  Margin="0,10,0,0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Orientation="Vertical" Spacing="8">
        <!-- Branch & Target Summary -->
        <Border Padding="10,7"
                CornerRadius="4"
                Background="{DynamicResource Brush.Contents}"
                BorderThickness="1"
                BorderBrush="{DynamicResource Brush.Border1}">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="90,*">
              <TextBlock Grid.Column="0"
                         FontSize="12"
                         Foreground="{DynamicResource Brush.FG2}"
                         VerticalAlignment="Center"
                         Text="{DynamicResource Text.Reset.Target}"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Path Width="13" Height="13" Data="{StaticResource Icons.Branch}" Fill="{DynamicResource Brush.FG1}"/>
                <TextBlock Classes="bold" Text="{Binding CurrentBranchDisplay, Mode=OneWay}"/>
                <Border Padding="6,1"
                        CornerRadius="8"
                        Background="#28D97706"
                        BorderBrush="#88D97706"
                        BorderThickness="1"
                        IsVisible="{Binding IsProtectionEffectivelyLocked, Mode=OneWay}">
                  <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="DarkOrange" Text="{DynamicResource Text.Reset.ProtectionBadge}"/>
                </Border>
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="90,*">
              <TextBlock Grid.Column="0"
                         FontSize="12"
                         Foreground="{DynamicResource Brush.FG2}"
                         VerticalAlignment="Center"
                         Text="{DynamicResource Text.Reset.MoveTo}"/>
              <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,*" VerticalAlignment="Center">
                <Path Grid.Column="0" Width="13" Height="13" Data="{StaticResource Icons.Commit}" Fill="{DynamicResource Brush.FG1}"/>
                <TextBlock Grid.Column="1"
                           Margin="6,0,0,0"
                           FontFamily="{DynamicResource Fonts.Monospace}"
                           Foreground="DarkOrange"
                           Text="{Binding TargetCommitShortSha, Mode=OneWay}"/>
                <TextBlock Grid.Column="2"
                           Margin="8,0,0,0"
                           Text="{Binding To.Subject}"
                           TextTrimming="CharacterEllipsis"/>
              </Grid>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Loading -->
        <TextBlock FontSize="12"
                   Foreground="{DynamicResource Brush.FG2}"
                   Text="{DynamicResource Text.Reset.LoadingPreflight}"
                   IsVisible="{Binding IsLoadingPreflight, Mode=OneWay}"/>

        <!-- Configuration View -->
        <StackPanel Orientation="Vertical"
                    Spacing="10"
                    IsVisible="{Binding ShowConfigurationForm, Mode=OneWay}">

          <!-- Blocking Error Box -->
          <Border Padding="10,8"
                  CornerRadius="4"
                  Background="#1EDC2626"
                  BorderThickness="1"
                  BorderBrush="#55DC2626"
                  IsVisible="{Binding HasBlockReason, Mode=OneWay}">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="Auto,*">
                <Path Grid.Column="0" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,8,0" Data="{StaticResource Icons.Error}" Fill="OrangeRed"/>
                <TextBlock Grid.Column="1"
                           Foreground="{DynamicResource Brush.FG1}"
                           TextWrapping="Wrap"
                           Text="{Binding BlockReason, Mode=OneWay}"/>
              </Grid>

              <StackPanel Spacing="2" Margin="22,2,0,0" IsVisible="{Binding HasCollisionPaths, Mode=OneWay}">
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="OrangeRed" Text="{DynamicResource Text.Reset.CollisionTitle}"/>
                <ItemsControl ItemsSource="{Binding CollisionPaths, Mode=OneWay}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock FontSize="11" FontFamily="{DynamicResource Fonts.Monospace}" TextWrapping="Wrap" Text="{Binding .}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Mode Selection (Strictly 2 Modes: Mixed / Hard) -->
          <Border Padding="10,8"
                  CornerRadius="4"
                  Background="{DynamicResource Brush.Contents}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource Brush.Border1}"
                  IsVisible="{Binding CanResetLocally, Mode=OneWay}">
            <StackPanel Spacing="6">
              <TextBlock FontSize="12" Classes="bold" Text="{DynamicResource Text.Reset.Mode}"/>

              <RadioButton GroupName="GitNestResetMode"
                           IsChecked="{Binding IsMixedMode, Mode=TwoWay}">
                <StackPanel Spacing="2" Margin="2,0">
                  <TextBlock FontSize="12" FontWeight="SemiBold" Text="{DynamicResource Text.Reset.Mode.Mixed}"/>
                  <TextBlock FontSize="11" Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" Text="{DynamicResource Text.Reset.Mode.MixedDesc}"/>
                </StackPanel>
              </RadioButton>

              <RadioButton GroupName="GitNestResetMode"
                           IsChecked="{Binding IsHardMode, Mode=TwoWay}">
                <StackPanel Spacing="2" Margin="2,0">
                  <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="OrangeRed" Text="{DynamicResource Text.Reset.Mode.Hard}"/>
                  <TextBlock FontSize="11" Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" Text="{DynamicResource Text.Reset.Mode.HardDesc}"/>
                </StackPanel>
              </RadioButton>
            </StackPanel>
          </Border>

          <!-- Cross-Merge & Multi-Author Warnings -->
          <Border Padding="10,7"
                  CornerRadius="4"
                  Background="#1ED97706"
                  BorderThickness="1"
                  BorderBrush="#55D97706"
                  IsVisible="{Binding HasCrossMergeNotice, Mode=OneWay}">
            <Grid ColumnDefinitions="Auto,*">
              <Path Grid.Column="0" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,8,0" Data="{StaticResource Icons.Error}" Fill="DarkOrange"/>
              <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap" Text="{Binding CrossMergeNoticeText, Mode=OneWay}"/>
            </Grid>
          </Border>

          <Border Padding="10,7"
                  CornerRadius="4"
                  Background="#1ED97706"
                  BorderThickness="1"
                  BorderBrush="#55D97706"
                  IsVisible="{Binding HasOtherAuthorsInLocal, Mode=OneWay}">
            <StackPanel Spacing="3">
              <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="DarkOrange" TextWrapping="Wrap" Text="{DynamicResource Text.Reset.OtherAuthorsWarning}"/>
              <TextBlock FontSize="11" TextWrapping="Wrap" Text="{Binding LocalAuthorsSummary, Mode=OneWay}"/>
            </StackPanel>
          </Border>

          <!-- Commits to Remove Preview -->
          <Border Padding="10,7"
                  CornerRadius="4"
                  Background="{DynamicResource Brush.Contents}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource Brush.Border1}"
                  IsVisible="{Binding HasLocalCommitsToRemove, Mode=OneWay}">
            <StackPanel Spacing="5">
              <TextBlock FontSize="12" Classes="bold" Text="{Binding CommitsToRemoveHeader, Mode=OneWay}"/>
              <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding LocalCommitsToRemove, Mode=OneWay}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="m:ResetCommitSummary">
                      <Grid ColumnDefinitions="72,*,Auto" Margin="0,2">
                        <TextBlock Grid.Column="0" FontSize="11" FontFamily="{DynamicResource Fonts.Monospace}" Foreground="DarkOrange" Text="{Binding ShortSha}"/>
                        <TextBlock Grid.Column="1" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding Subject}"/>
                        <TextBlock Grid.Column="2" Margin="8,0,0,0" FontSize="11" Foreground="{DynamicResource Brush.FG2}" Text="{Binding AuthorName}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>

          <!-- Upstream & Multi-Remote Tracking Status + Optional Remote History Rewrite -->
          <Border Padding="10,8"
                  CornerRadius="4"
                  Background="{DynamicResource Brush.Contents}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource Brush.Border1}">
            <StackPanel Spacing="6">
              <TextBlock FontSize="12" Classes="bold" Text="{DynamicResource Text.Reset.RemoteSectionTitle}"/>

              <!-- Protection Note -->
              <Border Padding="8,6"
                      CornerRadius="4"
                      Background="#14D97706"
                      BorderThickness="1"
                      BorderBrush="#44D97706"
                      IsVisible="{Binding IsProtectionEffectivelyLocked, Mode=OneWay}">
                <TextBlock FontSize="11" TextWrapping="Wrap" Text="{DynamicResource Text.Reset.ProtectionLockedHint}"/>
              </Border>
              <Border Padding="8,6"
                      CornerRadius="4"
                      Background="#1416A34A"
                      BorderThickness="1"
                      BorderBrush="#4416A34A"
                      IsVisible="{Binding IsProtectionLocallyUnlocked, Mode=OneWay}">
                <TextBlock FontSize="11" TextWrapping="Wrap" Text="{DynamicResource Text.Reset.ProtectionUnlockedHint}"/>
              </Border>

              <!-- Primary Upstream -->
              <StackPanel Spacing="4" IsVisible="{Binding HasConfiguredUpstream, Mode=OneWay}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" FontSize="11" Classes="bold" Text="{Binding ConfiguredUpstream?.TrackingRefName, Mode=OneWay}"/>
                  <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" Text="{Binding ConfiguredUpstream?.RemoteStatusLabel, Mode=OneWay}"/>
                </Grid>
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource Brush.FG2}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasDistinctConfiguredUpstreamDetail, Mode=OneWay}"
                           Text="{Binding ConfiguredUpstream?.Detail, Mode=OneWay}"/>
              </StackPanel>

              <!-- Optional Force-With-Lease Remote Rewrite Checkbox -->
              <CheckBox Content="{Binding AlsoRewriteRemoteLabel, Mode=OneWay}"
                        IsChecked="{Binding AlsoRewriteRemote, Mode=TwoWay}"
                        IsEnabled="{Binding CanEnableAlsoRewriteRemote, Mode=OneWay}"
                        IsVisible="{Binding HasConfiguredUpstream, Mode=OneWay}"/>

              <TextBlock FontSize="11"
                         Foreground="DarkOrange"
                         TextWrapping="Wrap"
                         IsVisible="{Binding HasRemoteRewriteHint, Mode=OneWay}"
                         Text="{Binding RemoteRewriteHintText, Mode=OneWay}"/>

              <!-- Additional Tracked Remotes -->
              <ItemsControl ItemsSource="{Binding AdditionalTrackedRemotes, Mode=OneWay}"
                            IsVisible="{Binding HasAdditionalTrackedRemotes, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="m:ResetUpstreamRemoteStatus">
                    <Border Margin="0,4,0,0" Padding="8,5" CornerRadius="3" Background="{DynamicResource Brush.SubPanel}">
                      <StackPanel Spacing="2">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                          <TextBlock Grid.Column="0" FontSize="11" FontWeight="SemiBold" Text="{Binding TrackingRefName}"/>
                          <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" Text="{Binding RemoteStatusLabel}"/>
                        </Grid>
                        <TextBlock FontSize="11" Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" Text="{Binding Detail}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Local Backup Notice -->
          <Grid ColumnDefinitions="Auto,*">
            <Path Grid.Column="0" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,6,0" Data="{StaticResource Icons.Info}" Fill="{DynamicResource Brush.FG2}"/>
            <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" Text="{DynamicResource Text.Reset.BackupNote}"/>
          </Grid>
        </StackPanel>

        <!-- Result / Partial Failure / Uncertain Recovery Card (Non-auto-closing) -->
        <StackPanel Orientation="Vertical"
                    Spacing="8"
                    IsVisible="{Binding HasResultView, Mode=OneWay}">
          <Border Padding="12,10"
                  CornerRadius="4"
                  Background="{DynamicResource Brush.Contents}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource Brush.Border1}">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Width="16" Height="16" Data="{StaticResource Icons.Error}" Fill="DarkOrange" IsVisible="{Binding IsResultWarning, Mode=OneWay}"/>
                <Path Width="16" Height="16" Data="{StaticResource Icons.Error}" Fill="OrangeRed" IsVisible="{Binding IsResultError, Mode=OneWay}"/>
                <TextBlock FontSize="15" Classes="bold" Text="{Binding ResultTitle, Mode=OneWay}"/>
              </StackPanel>

              <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding ResultSummary, Mode=OneWay}"/>
              <TextBlock FontSize="11" Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap"
                         IsVisible="{Binding HasResultDetail, Mode=OneWay}"
                         Text="{Binding ResultDetail, Mode=OneWay}"/>

              <Border Padding="8,6"
                      CornerRadius="4"
                      Background="#1E16A34A"
                      BorderThickness="1"
                      BorderBrush="#5516A34A"
                      IsVisible="{Binding CollaboratorCommitsPreserved, Mode=OneWay}">
                <TextBlock FontSize="11" TextWrapping="Wrap" Text="{DynamicResource Text.Reset.Result.CollaboratorHint}"/>
              </Border>

              <!-- Backup Ref Chip & Direct Recovery Log Shortcut (above details for narrow windows) -->
              <Border Padding="8,6"
                      CornerRadius="4"
                      Background="{DynamicResource Brush.SubPanel}"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource Brush.Border2}"
                      IsVisible="{Binding HasResultBackupRef, Mode=OneWay}">
                <StackPanel Spacing="3">
                  <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.FG2}" Text="{DynamicResource Text.Reset.Result.BackupRefLabel}"/>
                  <SelectableTextBlock FontSize="11" FontFamily="{DynamicResource Fonts.Monospace}" TextWrapping="Wrap" Text="{Binding ResultBackupRef, Mode=OneWay}"/>
                </StackPanel>
              </Border>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="flat primary"
                        Height="28" Padding="12,0" HorizontalAlignment="Left"
                        Content="{DynamicResource Text.Reset.Result.OpenRecoveryLogs}"
                        Click="OnOpenRecoveryLogsClicked"/>
                <Button Classes="flat"
                        Height="28" Padding="12,0"
                        IsVisible="{Binding CanRefreshFromResult, Mode=OneWay}"
                        Content="{DynamicResource Text.Reset.Result.RefreshSnapshot}"
                        Click="OnRefreshFromResultClicked"/>
              </StackPanel>

              <!-- Step results stacked cleanly for narrow/wide layouts -->
              <ItemsControl ItemsSource="{Binding ResultSteps, Mode=OneWay}" IsVisible="{Binding HasResultSteps, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="m:HistoryResetStepResult">
                    <StackPanel Spacing="2" Margin="0,3">
                      <TextBlock FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Label}"/>
                      <TextBlock Margin="10,0,0,0" FontSize="11" Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" Text="{Binding Detail}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </StackPanel>
</UserControl>

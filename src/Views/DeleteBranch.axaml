<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="450"
             x:Class="SourceGit.Views.DeleteBranch"
             x:DataType="vm:DeleteBranch"
             MaxWidth="620">
  <StackPanel Orientation="Vertical" Margin="8,0">
    <!-- Title -->
    <StackPanel Orientation="Horizontal">
      <Path Width="16" Height="16" Data="{StaticResource Icons.Clear}"/>
      <TextBlock FontSize="18"
                 Margin="8,0,0,0"
                 Classes="bold"
                 Text="{Binding DialogTitle, Mode=OneWay}"/>
    </StackPanel>

    <ScrollViewer MaxHeight="440"
                  Margin="0,12,0,0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Orientation="Vertical" Spacing="10">
        <!-- Branch summary card -->
        <Border Padding="10,8"
                CornerRadius="4"
                Background="{DynamicResource Brush.Contents}"
                BorderThickness="1"
                BorderBrush="{DynamicResource Brush.Border1}">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Width="14" Height="14" Data="{StaticResource Icons.Branch}"/>
              <TextBlock Classes="bold" Text="{Binding Target.FriendlyName}"/>
              <Border Height="18"
                      Padding="6,0"
                      VerticalAlignment="Center"
                      CornerRadius="9"
                      Background="{DynamicResource Brush.Badge}"
                      IsVisible="{Binding Target.IsTrackStatusVisible}">
                <TextBlock Foreground="{DynamicResource Brush.BadgeFG}"
                           FontFamily="{DynamicResource Fonts.Monospace}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Text="{Binding Target.TrackStatusDescription}"/>
              </Border>
              <TextBlock Foreground="{DynamicResource Brush.FG2}"
                         FontFamily="{DynamicResource Fonts.Monospace}"
                         FontSize="11"
                         VerticalAlignment="Center"
                         Text="{Binding TargetTipShortSha, Mode=OneWay}"/>
            </StackPanel>

            <Grid ColumnDefinitions="Auto,*">
              <Path Grid.Column="0" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,6,0" Data="{StaticResource Icons.Info}" Fill="{DynamicResource Brush.FG2}"/>
              <TextBlock Grid.Column="1"
                         FontSize="11"
                         Foreground="{DynamicResource Brush.FG2}"
                         TextWrapping="Wrap"
                         Text="{DynamicResource Text.DeleteBranch.CommitSafetyHint}"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Configuration View -->
        <StackPanel Orientation="Vertical"
                    Spacing="10"
                    IsVisible="{Binding ShowConfigurationForm, Mode=OneWay}">
          <TextBlock FontSize="11"
                     Foreground="{DynamicResource Brush.FG2}"
                     Text="{DynamicResource Text.DeleteBranch.LoadingPreflight}"
                     IsVisible="{Binding IsLoadingPreflight, Mode=OneWay}"/>

          <!-- Current branch block -->
          <Border Padding="10,8"
                  CornerRadius="4"
                  Background="#1EDC2626"
                  BorderThickness="1"
                  BorderBrush="#55DC2626"
                  IsVisible="{Binding IsCurrent, Mode=OneWay}">
            <Grid ColumnDefinitions="Auto,*">
              <Path Grid.Column="0" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,8,0" Data="{StaticResource Icons.Error}" Fill="OrangeRed"/>
              <TextBlock Grid.Column="1"
                         Foreground="{DynamicResource Brush.FG1}"
                         TextWrapping="Wrap"
                         Text="{Binding CurrentBlockMessage, Mode=OneWay}"/>
            </Grid>
          </Border>

          <!-- Worktree removed step note -->
          <Border Padding="10,6"
                  CornerRadius="4"
                  Background="#1E16A34A"
                  BorderThickness="1"
                  BorderBrush="#4416A34A"
                  IsVisible="{Binding HasWorktreeRemovedNotice, Mode=OneWay}">
            <Grid ColumnDefinitions="Auto,*">
              <Path Grid.Column="0" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,8,0" Data="{StaticResource Icons.CheckCircled}" Fill="ForestGreen"/>
              <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding WorktreeRemovedNotice, Mode=OneWay}"/>
            </Grid>
          </Border>

          <!-- Attached worktree protection & cleanup sequence -->
          <Border Padding="10,8"
                  CornerRadius="4"
                  Background="#1EFF8C00"
                  BorderThickness="1"
                  BorderBrush="#55FF8C00"
                  IsVisible="{Binding IsCheckedOutInOtherWorktree, Mode=OneWay}">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="Auto,*">
                <Path Grid.Column="0" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,8,0" Data="{StaticResource Icons.Error}" Fill="DarkOrange"/>
                <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding WorktreeBlockMessage, Mode=OneWay}"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasAttachedWorktreeDetail, Mode=OneWay}">
                <Path Grid.Column="0" Width="12" Height="12" VerticalAlignment="Top" Margin="2,3,8,0" Data="{StaticResource Icons.Info}" Fill="DarkOrange"/>
                <TextBlock Grid.Column="1" FontSize="11" TextWrapping="Wrap" Text="{Binding AttachedWorktreeDetail, Mode=OneWay}"/>
              </Grid>
              <CheckBox IsEnabled="{Binding CanCheckDeleteAttachedWorktree, Mode=OneWay}"
                        IsChecked="{Binding DeleteWorktree, Mode=TwoWay}"
                        Content="{DynamicResource Text.DeleteBranch.DeleteAttachedWorktreeOrder}"/>
              <CheckBox Margin="20,0,0,0"
                        IsChecked="{Binding ForceRemoveWorktree, Mode=TwoWay}"
                        IsVisible="{Binding AttachedWorktreeNeedsForceOption, Mode=OneWay}"
                        Content="{DynamicResource Text.DeleteBranch.ForceWorktree}"/>
            </StackPanel>
          </Border>

          <!-- Linked upstream remote option (local branches with real upstream only) -->
          <StackPanel Spacing="6" IsVisible="{Binding HasConfiguredUpstream, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <CheckBox IsChecked="{Binding DeleteUpstream, Mode=TwoWay}">
                <v:NameHighlightedTextBlock Foreground="{DynamicResource Brush.FG1}"
                                            Text="{Binding DeleteUpstreamTip, Mode=OneWay}"
                                            VerticalAlignment="Center"/>
              </CheckBox>
              <Border Height="18"
                      Padding="6,0"
                      CornerRadius="9"
                      VerticalAlignment="Center"
                      Background="{DynamicResource Brush.Badge}"
                      IsVisible="{Binding IsUpstreamNameDifferent, Mode=OneWay}">
                <TextBlock FontSize="10"
                           Foreground="{DynamicResource Brush.BadgeFG}"
                           VerticalAlignment="Center"
                           Text="{DynamicResource Text.DeleteBranch.DifferentUpstreamNameTag}"/>
              </Border>
            </StackPanel>

            <!-- Explicit two-target list when linked upstream delete is checked -->
            <Border Padding="10,8"
                    CornerRadius="4"
                    Background="{DynamicResource Brush.Contents}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource Brush.Border1}"
                    IsVisible="{Binding ShowLinkedTargetsBreakdown, Mode=OneWay}">
              <StackPanel Spacing="4">
                <TextBlock Classes="bold" FontSize="11" Text="{DynamicResource Text.DeleteBranch.AffectedTargetsTitle}"/>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,2,0,0">
                  <TextBlock Grid.Row="0" Grid.Column="0" FontSize="11" Foreground="{DynamicResource Brush.FG2}" Margin="0,0,8,0" Text="{DynamicResource Text.DeleteBranch.TargetLocalLabel}"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" FontSize="11" FontFamily="{DynamicResource Fonts.Monospace}" TextWrapping="Wrap">
                    <Run Text="refs/heads/"/><Run Text="{Binding Target.Name}"/>
                    <Run Text=" ("/><Run Text="{Binding TargetTipShortSha, Mode=OneWay}"/><Run Text=")"/>
                  </TextBlock>

                  <TextBlock Grid.Row="1" Grid.Column="0" FontSize="11" Foreground="{DynamicResource Brush.FG2}" Margin="0,2,8,0" Text="{DynamicResource Text.DeleteBranch.TargetRemoteLabel}"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" FontFamily="{DynamicResource Fonts.Monospace}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding ConfiguredUpstreamFriendly, Mode=OneWay}"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" FontSize="11" Foreground="{DynamicResource Brush.FG2}" Margin="0,2,8,0" Text="{DynamicResource Text.DeleteBranch.RemoteUrlLabel}"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" FontSize="11" FontFamily="{DynamicResource Fonts.Monospace}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding RedactedRemoteUrl, Mode=OneWay}"/>

                  <TextBlock Grid.Row="3" Grid.Column="0" FontSize="11" Foreground="{DynamicResource Brush.FG2}" Margin="0,2,8,0" VerticalAlignment="Center" Text="{DynamicResource Text.DeleteBranch.RemoteTipLabel}"/>
                  <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                    <TextBlock Grid.Column="0" FontSize="11" FontFamily="{DynamicResource Fonts.Monospace}" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding RemoteLiveStatusText, Mode=OneWay}"/>
                    <Button Grid.Column="1" Classes="flat" Height="22" Margin="8,0,0,0" Padding="8,0" VerticalAlignment="Center" FontSize="11" Content="{DynamicResource Text.DeleteBranch.RefreshRemoteBtn}" Click="OnRefreshRemoteProbe"/>
                  </Grid>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Standalone remote branch confirmation details -->
          <Border Padding="10,8"
                  CornerRadius="4"
                  Background="{DynamicResource Brush.Contents}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource Brush.Border1}"
                  IsVisible="{Binding IsRemote, Mode=OneWay}">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" FontSize="11" Foreground="{DynamicResource Brush.FG2}" Margin="0,0,8,0" Text="{DynamicResource Text.DeleteBranch.RemoteUrlLabel}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" FontSize="11" FontFamily="{DynamicResource Fonts.Monospace}" TextWrapping="Wrap" Text="{Binding RedactedRemoteUrl, Mode=OneWay}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" FontSize="11" Foreground="{DynamicResource Brush.FG2}" Margin="0,2,8,0" Text="{DynamicResource Text.DeleteBranch.Branch}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" FontFamily="{DynamicResource Fonts.Monospace}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding RemoteBranchFullDisplay, Mode=OneWay}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" FontSize="11" Foreground="{DynamicResource Brush.FG2}" Margin="0,2,8,0" VerticalAlignment="Center" Text="{DynamicResource Text.DeleteBranch.RemoteTipLabel}"/>
                <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                  <TextBlock Grid.Column="0" FontSize="11" FontFamily="{DynamicResource Fonts.Monospace}" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding RemoteLiveStatusText, Mode=OneWay}"/>
                  <Button Grid.Column="1" Classes="flat" Height="22" Margin="8,0,0,0" Padding="8,0" VerticalAlignment="Center" FontSize="11" Content="{DynamicResource Text.DeleteBranch.RefreshRemoteBtn}" Click="OnRefreshRemoteProbe"/>
                </Grid>
              </Grid>

              <Grid ColumnDefinitions="Auto,*">
                <Path Grid.Column="0" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,6,0" Data="{StaticResource Icons.Error}" Fill="DarkOrange"/>
                <TextBlock Grid.Column="1"
                           FontSize="11"
                           Foreground="{DynamicResource Brush.FG2}"
                           TextWrapping="Wrap"
                           Text="{DynamicResource Text.DeleteBranch.RemoteLeaseSafetyTip}"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Server missing branch -> explicit cache prune notice -->
          <Border Padding="10,8"
                  CornerRadius="4"
                  Background="#1EFF8C00"
                  BorderThickness="1"
                  BorderBrush="#55FF8C00"
                  IsVisible="{Binding ShowCachePruneNotice, Mode=OneWay}">
            <Grid ColumnDefinitions="Auto,*">
              <Path Grid.Column="0" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,8,0" Data="{StaticResource Icons.Info}" Fill="DarkOrange"/>
              <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding CachePruneConfirmMessage, Mode=OneWay}"/>
            </Grid>
          </Border>

          <!-- Unmerged commits preview & secondary 'Force Delete Anyway' step -->
          <Border Padding="10,8"
                  CornerRadius="4"
                  Background="#1EFF8C00"
                  BorderThickness="1"
                  BorderBrush="#55FF8C00"
                  IsVisible="{Binding ShowUnmergedSection, Mode=OneWay}">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="Auto,*">
                <Path Grid.Column="0" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,8,0" Data="{StaticResource Icons.Error}" Fill="DarkOrange"/>
                <TextBlock Grid.Column="1" Classes="bold" TextWrapping="Wrap" Text="{Binding UnmergedSectionHeader, Mode=OneWay}"/>
              </Grid>

              <ItemsControl ItemsSource="{Binding UnmergedCommits}" Margin="20,0,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="m:UnmergedCommitSummary">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                      <TextBlock Grid.Column="0" FontFamily="{DynamicResource Fonts.Monospace}" FontSize="11" Margin="0,0,8,0" Foreground="{DynamicResource Brush.FG2}" Text="{Binding ShortSha}"/>
                      <TextBlock Grid.Column="1" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding Subject}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Margin="20,2,0,0"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource Brush.FG1}"
                         IsVisible="{Binding InForceLocalConfirmStep, Mode=OneWay}"
                         Text="{DynamicResource Text.DeleteBranch.ForceRequiredHint}"/>
            </StackPanel>
          </Border>

          <!-- Inline error / snapshot stale / lease reject -->
          <Border Padding="10,8"
                  CornerRadius="4"
                  Background="#1EDC2626"
                  BorderThickness="1"
                  BorderBrush="#55DC2626"
                  IsVisible="{Binding HasInlineError, Mode=OneWay}">
            <Grid ColumnDefinitions="Auto,*">
              <Path Grid.Column="0" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,8,0" Data="{StaticResource Icons.Error}" Fill="OrangeRed"/>
              <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding InlineErrorMessage, Mode=OneWay}"/>
            </Grid>
          </Border>
        </StackPanel>

        <!-- Step-by-step Partial Success Result & Backup Recovery View -->
        <StackPanel Orientation="Vertical"
                    Spacing="10"
                    IsVisible="{Binding HasResultView, Mode=OneWay}">
          <Border Padding="10,8"
                  CornerRadius="4"
                  Background="#1EFF8C00"
                  BorderThickness="1"
                  BorderBrush="#55FF8C00">
            <Grid ColumnDefinitions="Auto,*">
              <Path Grid.Column="0" Width="15" Height="15" VerticalAlignment="Top" Margin="0,2,8,0" Data="{StaticResource Icons.Error}" Fill="DarkOrange"/>
              <TextBlock Grid.Column="1" Classes="bold" TextWrapping="Wrap" Text="{Binding ResultSummary, Mode=OneWay}"/>
            </Grid>
          </Border>

          <Border Padding="10,8"
                  CornerRadius="4"
                  Background="{DynamicResource Brush.Contents}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource Brush.Border1}">
            <ItemsControl ItemsSource="{Binding StepResults}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:BranchDeleteStepDisplayItem">
                  <Grid ColumnDefinitions="Auto,*" Margin="0,3">
                    <Path Grid.Column="0"
                          Width="14" Height="14"
                          Margin="0,2,8,0"
                          VerticalAlignment="Top"
                          Data="{Binding IconKey, Converter={x:Static v:DeleteBranch.StepIconConverter}}"
                          Fill="{Binding IconBrush}"/>
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock TextWrapping="Wrap" Text="{Binding Label}"/>
                      <TextBlock FontSize="11" Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap" IsVisible="{Binding HasDetail}" Text="{Binding Detail}"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <!-- Local backup recovery row -->
          <Border Padding="10,8"
                  CornerRadius="4"
                  Background="{DynamicResource Brush.Contents}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource Brush.Border1}"
                  IsVisible="{Binding CanRestoreLocalFromBackup, Mode=OneWay}">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto">
              <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="{DynamicResource Text.DeleteBranch.RestoringTargetLabel}"/>
              <TextBox Grid.Column="1" Height="28" VerticalAlignment="Center" Text="{Binding RestorableBranchName, Mode=TwoWay}"/>
              <Button Grid.Column="2"
                      Classes="flat primary"
                      Height="28"
                      Margin="8,0,0,0"
                      Padding="12,0"
                      IsEnabled="{Binding !IsRestoringBackup, Mode=OneWay}"
                      Content="{DynamicResource Text.DeleteBranch.RestoreLocalBtn}"
                      Click="OnRestoreLocalFromBackup"/>
            </Grid>
          </Border>

          <Border Padding="10,8"
                  CornerRadius="4"
                  Background="#1E16A34A"
                  BorderThickness="1"
                  BorderBrush="#4416A34A"
                  IsVisible="{Binding HasRestoreFeedback, Mode=OneWay}">
            <TextBlock TextWrapping="Wrap" Text="{Binding RestoreFeedbackMessage, Mode=OneWay}"/>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </StackPanel>
</UserControl>

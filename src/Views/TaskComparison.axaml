<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:m="using:SourceGit.Models"
             xmlns:v="using:SourceGit.Views"
             x:Class="SourceGit.Views.TaskComparison"
             x:DataType="vm:TaskComparison">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="8" RowSpacing="6">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <StackPanel>
        <TextBlock Text="{DynamicResource Text.TaskCompare.Title}" FontWeight="Bold" FontSize="16"/>
        <TextBlock Text="{Binding FullPath}" FontSize="11" Foreground="{DynamicResource Brush.FG2}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FullPath}"/>
      </StackPanel>
      <Button Grid.Column="1" Classes="flat" Content="{DynamicResource Text.TaskCompare.Refresh}" Command="{Binding RefreshAsync}" IsEnabled="{Binding !IsLoading}"/>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="8">
      <TextBlock Text="{DynamicResource Text.TaskCompare.Target}" VerticalAlignment="Center"/>
      <ComboBox Grid.Column="1" x:Name="TargetBox" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget, Mode=TwoWay}" IsEnabled="{Binding !IsLoading}" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding SelectedTarget}"/>
      <TextBlock Grid.Row="1" Text="{DynamicResource Text.TaskCompare.Mode}" VerticalAlignment="Center"/>
      <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ModeBox" ItemsSource="{Binding Modes}" SelectedIndex="{Binding SelectedMode, Mode=TwoWay}" IsEnabled="{Binding !IsLoading}" HorizontalAlignment="Stretch"/>
    </Grid>
    <StackPanel Grid.Row="2" Spacing="4">
      <Border x:Name="StaleNotice" IsVisible="{Binding IsStale}" Padding="8" CornerRadius="4" Background="{DynamicResource Brush.Conflict}">
        <TextBlock Text="{DynamicResource Text.TaskCompare.Stale}" Foreground="{DynamicResource Brush.Conflict.Foreground}" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Text="{Binding ErrorText}" IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}"/>
      <TextBlock Text="{Binding SaveError}" IsVisible="{Binding SaveError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}"/>
      <ProgressBar IsVisible="{Binding IsLoading}" IsIndeterminate="True" Height="3"/>
    </StackPanel>
    <Border Grid.Row="3" IsVisible="{Binding CanDisplay}" Padding="8" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}" Background="{DynamicResource Brush.Contents}">
      <StackPanel Spacing="4">
        <TextBlock Text="{DynamicResource Text.TaskCompare.Source}" Foreground="{DynamicResource Brush.FG2}" FontSize="11"/>
        <TextBlock Text="{Binding SourceDescription}" FontSize="11" TextWrapping="Wrap"/>
        <TextBlock Text="{DynamicResource Text.TaskCompare.TargetSnapshot}" Foreground="{DynamicResource Brush.FG2}" FontSize="11"/>
        <TextBlock Text="{Binding TargetDescription}" FontSize="11" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding TargetCacheDescription}" IsVisible="{Binding TargetCacheDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}"/>
        <TextBlock Text="{Binding BaseDescription}" FontSize="11" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Summary}" FontWeight="Bold" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <StackPanel>
        <TextBlock Text="{DynamicResource Text.TaskCompare.Uncommitted}" FontWeight="Bold"/>
        <TextBlock Text="{Binding WorkingCopyDescription}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}"/>
      </StackPanel>
      <Button Grid.Column="1" Classes="flat" Content="{DynamicResource Text.Repository.ViewChanges}" Command="{Binding ShowUncommittedChanges}"/>
    </Grid>
    <Grid Grid.Row="5" IsVisible="{Binding CanDisplay}" ColumnDefinitions="220,4,*">
      <Grid RowDefinitions="*,Auto,100">
        <v:ChangeCollectionView x:Name="Files" Changes="{Binding Changes}" Selection="{Binding ChangeSelection, Mode=TwoWay}" ViewMode="List"/>
        <TextBlock Grid.Row="1" Text="{Binding CommitSummary}" TextWrapping="Wrap" FontSize="11" Margin="0,4" Foreground="{DynamicResource Brush.FG2}"/>
        <ListBox Grid.Row="2" ItemsSource="{Binding Commits}">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="m:TaskComparisonCommit">
              <StackPanel Margin="4,2">
                <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Subject}"/>
                <TextBlock Text="{Binding SHA}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SHA}" Foreground="{DynamicResource Brush.FG2}"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
      <GridSplitter Grid.Column="1" Background="Transparent" HorizontalAlignment="Stretch"/>
      <Grid Grid.Column="2">
        <TextBlock Text="{DynamicResource Text.Diff.Welcome}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap"/>
        <ContentControl Content="{Binding DiffContext}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:DiffContext"><v:DiffView/></DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </Grid>
    </Grid>
  </Grid>
</UserControl>

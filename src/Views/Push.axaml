<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="450"
             x:Class="SourceGit.Views.Push"
             x:DataType="vm:Push">
  <StackPanel Orientation="Vertical" Margin="8,0">
    <StackPanel Orientation="Horizontal">
      <Path Width="16" Height="16"
            Data="{StaticResource Icons.Push}"/>

      <TextBlock FontSize="18"
                 Margin="8,0,0,0"
                 Classes="bold"
                 Text="{DynamicResource Text.Push.Title}"/>
    </StackPanel>

    <Grid Margin="0,16,0,0" RowDefinitions="32,32,32,Auto,Auto,Auto,Auto" ColumnDefinitions="130,*">
      <TextBlock Grid.Row="0" Grid.Column="0"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,8,0"
                 Text="{DynamicResource Text.Push.Local}"/>
      <v:BranchSelector Grid.Row="0" Grid.Column="1"
                        Height="28"
                        VerticalAlignment="Center" HorizontalAlignment="Stretch"
                        Branches="{Binding LocalBranches}"
                        SelectedBranch="{Binding SelectedLocalBranch, Mode=TwoWay}"
                        IsEnabled="{Binding !HasSpecifiedLocalBranch}"/>

      <TextBlock Grid.Row="1" Grid.Column="0"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,8,0"
                 Text="{DynamicResource Text.Push.Remote}"/>
      <ComboBox Grid.Row="1" Grid.Column="1"
                Height="28" Padding="8,0"
                VerticalAlignment="Center" HorizontalAlignment="Stretch"
                ItemsSource="{Binding Remotes}"
                SelectedItem="{Binding SelectedRemote, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="{x:Type m:Remote}">
            <StackPanel Orientation="Horizontal" Height="20" VerticalAlignment="Center">
              <Path Margin="0,2,8,0" Width="14" Height="14" Fill="{DynamicResource Brush.FG1}" Data="{StaticResource Icons.Remote}"/>
              <TextBlock Text="{Binding Name}"/>
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Grid.Row="2" Grid.Column="0"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,8,0"
                 Text="{DynamicResource Text.Push.To}"/>
      <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto">
        <v:BranchSelector Grid.Column="0"
                          Height="28"
                          VerticalAlignment="Center" HorizontalAlignment="Stretch"
                          Branches="{Binding RemoteBranches, Mode=OneWay}"
                          SelectedBranch="{Binding SelectedRemoteBranch, Mode=TwoWay}"
                          UsePureName="True"/>

        <Button Grid.Column="1"
                Classes="icon_button"
                Width="26" Height="32"
                Click="OnPushToNewBranch"
                ToolTip.Tip="{DynamicResource Text.PushToNewBranch}">
          <Path Width="14" Height="14" Data="{StaticResource Icons.Branch.Add}"/>
        </Button>
      </Grid>

      <TextBlock Grid.Row="3" Grid.Column="0"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,6,8,0"
                 Text="{DynamicResource Text.Push.RefspecPreview}"/>
      <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Vertical" Margin="0,6,0,4" Spacing="3">
        <TextBlock Text="{Binding RefspecPreview, Mode=OneWay}"
                   FontFamily="{DynamicResource Fonts.Monospace}"
                   FontSize="12"
                   TextWrapping="Wrap"/>
        <TextBlock Text="{DynamicResource Text.Push.SingleBranchOnlyNote}"
                   Foreground="{DynamicResource Brush.FG2}"
                   FontSize="12"
                   TextWrapping="Wrap"/>
        <TextBlock Text="{DynamicResource Text.Push.NoUpstreamHint}"
                   Foreground="{DynamicResource Brush.Accent}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   IsVisible="{Binding ShowNoUpstreamHint, Mode=OneWay}"/>
      </StackPanel>

      <CheckBox Grid.Row="4" Grid.Column="1"
                Height="30"
                Content="{DynamicResource Text.Push.Tracking}"
                IsChecked="{Binding Tracking, Mode=TwoWay}"
                IsVisible="{Binding IsSetTrackOptionVisible}"
                ToolTip.Tip="-u"/>

      <CheckBox Grid.Row="5" Grid.Column="1"
                Height="30"
                Content="{DynamicResource Text.Push.CheckSubmodules}"
                IsChecked="{Binding CheckSubmodules, Mode=TwoWay}"
                IsVisible="{Binding IsCheckSubmodulesVisible}"
                ToolTip.Tip="--recurse-submodules=check"/>

      <CheckBox Grid.Row="6" Grid.Column="1"
                Height="30"
                Content="{DynamicResource Text.Push.NoVerify}"
                IsChecked="{Binding NoVerify, Mode=TwoWay}"
                ToolTip.Tip="--no-verify"/>
    </Grid>

    <TextBlock Margin="130,2,0,0"
               Text="{DynamicResource Text.Push.NoForceHint}"
               Foreground="{DynamicResource Brush.FG2}"
               FontSize="12"
               TextWrapping="Wrap"/>

    <Border Margin="0,10,0,0"
            Padding="10,8"
            CornerRadius="4"
            BorderThickness="1"
            Background="{DynamicResource Brush.Contents}"
            BorderBrush="{DynamicResource Brush.Accent}"
            IsVisible="{Binding ConfirmExistingRemoteRequired, Mode=OneWay}">
      <StackPanel Orientation="Vertical" Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0"
                Fill="{DynamicResource Brush.Accent}"
                Data="{StaticResource Icons.Info}"/>
          <TextBlock Text="{Binding ConfirmExistingRemotePrompt, Mode=OneWay}"
                     TextWrapping="Wrap"/>
        </StackPanel>
        <CheckBox Margin="22,0,0,0"
                  Content="{Binding ConfirmExistingRemoteCheckboxText, Mode=OneWay}"
                  IsChecked="{Binding ConfirmOverwriteExistingRemoteBranchWithoutUpstream, Mode=TwoWay}"/>
      </StackPanel>
    </Border>

    <Border Margin="0,10,0,0"
            Padding="10,8"
            CornerRadius="4"
            BorderThickness="1"
            Background="{DynamicResource Brush.Contents}"
            BorderBrush="{DynamicResource Brush.Conflict}"
            IsVisible="{Binding HasPushErrorBanner, Mode=OneWay}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Path Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0"
              Fill="{DynamicResource Brush.Conflict}"
              Data="{StaticResource Icons.Error}"/>
        <TextBlock Text="{Binding PushErrorSummary, Mode=OneWay}"
                   TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>

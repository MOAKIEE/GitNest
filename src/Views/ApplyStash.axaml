<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:v="using:SourceGit.Views"
             xmlns:vm="using:SourceGit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="530" d:DesignHeight="340"
             x:Class="SourceGit.Views.ApplyStash"
             x:DataType="vm:ApplyStash">
  <StackPanel Orientation="Vertical" Margin="8,0" Spacing="10">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Path Width="16" Height="16" Data="{StaticResource Icons.Stashes}"/>
      <TextBlock FontSize="18" FontWeight="Bold" Classes="bold" Text="{DynamicResource Text.ApplyStash}"/>
    </StackPanel>

    <!-- Target Stash Summary Card -->
    <Border Background="{DynamicResource Brush.Contents}"
            BorderBrush="{DynamicResource Brush.Border1}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10,8">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="110,*">
        <TextBlock Grid.Row="0" Grid.Column="0"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   Margin="0,0,8,0"
                   Foreground="{DynamicResource Brush.FG2}"
                   Text="{DynamicResource Text.ApplyStash.Stash}"/>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock FontFamily="{DynamicResource Fonts.Monospace}" FontWeight="Bold" Text="{Binding Stash.Name}"/>
          <TextBlock FontFamily="{DynamicResource Fonts.Monospace}" Foreground="{DynamicResource Brush.FG2}" Text="{Binding StashShortSha}"/>
          <Border Padding="5,1" CornerRadius="3" Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="1">
            <TextBlock FontSize="11" Text="{Binding SourceBranchDisplay}"/>
          </Border>
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="0"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   Margin="0,6,8,0"
                   Foreground="{DynamicResource Brush.FG2}"
                   Text="{DynamicResource Text.ApplyStash.Subject}"/>
        <TextBlock Grid.Row="1" Grid.Column="1"
                   Margin="0,6,0,0"
                   Text="{Binding Stash.DisplaySubject}"
                   TextTrimming="CharacterEllipsis"/>
      </Grid>
    </Border>

    <!-- Main Form -->
    <StackPanel Orientation="Vertical" Spacing="8" IsVisible="{Binding !HasResultView}">
      <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="110,*">
        <CheckBox Grid.Row="0" Grid.Column="1"
                  Content="{DynamicResource Text.ApplyStash.RestoreIndex}"
                  IsChecked="{Binding RestoreIndex, Mode=TwoWay}"/>
        <CheckBox Grid.Row="1" Grid.Column="1"
                  Content="{DynamicResource Text.ApplyStash.DropAfterApply}"
                  IsChecked="{Binding DropAfterApply, Mode=TwoWay}"/>
        <CheckBox Grid.Row="2" Grid.Column="1"
                  Margin="0,2,0,0"
                  Content="{DynamicResource Text.ApplyStash.AllowDirtyWorkingTree}"
                  IsVisible="{Binding ShowAllowDirtyOption}"
                  IsChecked="{Binding AllowDirtyWorkingTree, Mode=TwoWay}"/>
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsLoadingPreflight}">
        <Path Width="13" Height="13" Data="{StaticResource Icons.Waiting}"/>
        <TextBlock FontSize="12" Foreground="{DynamicResource Brush.FG2}" Text="{DynamicResource Text.ApplyStash.LoadingPreflight}"/>
      </StackPanel>

      <!-- Blocking Errors -->
      <Border Background="#1AE05252"
              BorderBrush="#66E05252"
              BorderThickness="1"
              CornerRadius="4"
              Padding="10,8"
              IsVisible="{Binding HasBlockingReasons}">
        <StackPanel Orientation="Vertical" Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Width="14" Height="14" Data="{StaticResource Icons.Error}" Fill="#E05252"/>
            <TextBlock FontSize="12" FontWeight="Bold" Text="{DynamicResource Text.ApplyStash.BlockedTitle}"/>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding BlockingReasons}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="x:String">
                <TextBlock FontSize="12" Text="{Binding}" TextWrapping="Wrap" Margin="0,1"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Colliding Untracked / Ignored Files -->
      <Border Background="#18D97706"
              BorderBrush="#66D97706"
              BorderThickness="1"
              CornerRadius="4"
              Padding="10,8"
              IsVisible="{Binding HasCollidingPaths}">
        <StackPanel Orientation="Vertical" Spacing="4">
          <TextBlock FontSize="12" FontWeight="Bold" Text="{DynamicResource Text.ApplyStash.CollidingTitle}"/>
          <ScrollViewer MaxHeight="90" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding CollidingPaths}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="x:String">
                  <TextBlock FontSize="11.5" FontFamily="{DynamicResource Fonts.Monospace}" Text="{Binding}" TextWrapping="Wrap"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <!-- Estimated Affected Files -->
      <Border Background="{DynamicResource Brush.Contents}"
              BorderBrush="{DynamicResource Brush.Border1}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="10,8"
              IsVisible="{Binding HasEstimatedPaths}">
        <StackPanel Orientation="Vertical" Spacing="4">
          <TextBlock FontSize="12" FontWeight="Bold" Text="{Binding PreflightSummary}"/>
          <ScrollViewer MaxHeight="110" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding EstimatedPaths}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="x:String">
                  <TextBlock FontSize="11.5" FontFamily="{DynamicResource Fonts.Monospace}" Text="{Binding}" Margin="0,1" TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Non-Auto-Closing Result Card (Conflict Retained / Failure) -->
    <Border Background="{DynamicResource Brush.Contents}"
            BorderBrush="{DynamicResource Brush.Border1}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="12,10"
            IsVisible="{Binding HasResultView}">
      <StackPanel Orientation="Vertical" Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Width="16" Height="16" Data="{StaticResource Icons.Info}" Fill="#D97706" IsVisible="{Binding IsResultConflictRetained}"/>
          <Path Width="16" Height="16" Data="{StaticResource Icons.Error}" Fill="#E05252" IsVisible="{Binding !IsResultConflictRetained}"/>
          <TextBlock FontSize="13.5" FontWeight="Bold" Text="{Binding ResultTitle}"/>
        </StackPanel>
        <TextBlock FontSize="12" Text="{Binding ResultSummary}" TextWrapping="Wrap"/>
        <ScrollViewer MaxHeight="140" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding ResultLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="x:String">
                <TextBlock FontSize="11.5" FontFamily="{DynamicResource Fonts.Monospace}" Text="{Binding}" Margin="0,1" TextWrapping="Wrap"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>

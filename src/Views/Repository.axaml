<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceGit.Views.Repository"
             x:DataType="vm:Repository"
             x:Name="ThisControl">  
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="88"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Page Switcher -->
    <Grid Grid.Column="0" Width="88" RowDefinitions="Auto,*,Auto,12">
      <ListBox Background="Transparent" SelectedIndex="{Binding SelectedViewIndex, Mode=TwoWay}" SelectionMode="AlwaysSelected">
        <ListBox.Styles>
          <Style Selector="Path.icon">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Fill" Value="{DynamicResource Brush.FG1}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
          </Style>
          <Style Selector="ListBoxItem">
            <Setter Property="Height" Value="60"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
          </Style>
          <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#18888888"/>
          </Style>
          <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentHovered}"/>
          </Style>
        </ListBox.Styles>

        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Vertical"/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>

        <ListBoxItem ToolTip.Placement="Right">
          <ToolTip.Tip>
            <TextBlock>
              <Run Text="{DynamicResource Text.Dashboard}" Foreground="{DynamicResource Brush.FG1}"/>
              <Run Text=" "/>
              <Run Text="{OnPlatform Ctrl+1, macOS=⌘+1}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
            </TextBlock>
          </ToolTip.Tip>
          <StackPanel Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Path Classes="icon" Data="{StaticResource Icons.Dashboard}"/>
            <TextBlock Text="{DynamicResource Text.Dashboard}" FontSize="12"/>
          </StackPanel>
        </ListBoxItem>

        <ListBoxItem IsVisible="{Binding !IsBare}" ToolTip.Placement="Right">
          <ToolTip.Tip>
            <TextBlock>
              <Run Text="{DynamicResource Text.WorkingCopy}" Foreground="{DynamicResource Brush.FG1}"/>
              <Run Text=" "/>
              <Run Text="{OnPlatform Ctrl+2, macOS=⌘+2}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
            </TextBlock>
          </ToolTip.Tip>
          <StackPanel Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid Height="24" Width="56">
              <Path Classes="icon" Data="{StaticResource Icons.Changes}"/>
              <Border Height="14"
                      Margin="0,4,4,0" Padding="5,0"
                      CornerRadius="7"
                      HorizontalAlignment="Right" VerticalAlignment="Top"
                      Background="{DynamicResource Brush.Accent}"
                      IsVisible="{Binding LocalChangesCount, Mode=OneWay, Converter={x:Static c:IntConverters.IsGreaterThanZero}}">
                <TextBlock Text="{Binding LocalChangesCount, Mode=OneWay, Converter={x:Static c:IntConverters.ToBadgeWithLimit}}"
                           Foreground="White"
                           FontFamily="{DynamicResource Fonts.Monospace}"
                           FontSize="10"/>
              </Border>
              <Path Width="12" Height="12"
                    Margin="0,0,4,4"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Data="{StaticResource Icons.Info}"
                    Fill="DarkOrange"
                    IsVisible="{Binding InProgressContext, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </Grid>
            <TextBlock Text="{DynamicResource Text.WorkingCopy}" FontSize="12" HorizontalAlignment="Center"/>
          </StackPanel>
        </ListBoxItem>

        <ListBoxItem IsVisible="{Binding !IsBare}" ToolTip.Placement="Right">
          <ToolTip.Tip>
            <TextBlock>
              <Run Text="{DynamicResource Text.Stashes}" Foreground="{DynamicResource Brush.FG1}"/>
              <Run Text=" "/>
              <Run Text="{OnPlatform Ctrl+3, macOS=⌘+3}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
            </TextBlock>
          </ToolTip.Tip>
          <StackPanel Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid Height="24" Width="56">
              <Path Classes="icon" Data="{StaticResource Icons.Stashes}"/>
              <Border Height="14"
                      Margin="0,4,4,0" Padding="5,0"
                      CornerRadius="7"
                      HorizontalAlignment="Right" VerticalAlignment="Top"
                      Background="{DynamicResource Brush.Accent}"
                      IsVisible="{Binding StashesCount, Mode=OneWay, Converter={x:Static c:IntConverters.IsGreaterThanZero}}">
                <TextBlock Text="{Binding StashesCount, Mode=OneWay, Converter={x:Static c:IntConverters.ToBadgeWithLimit}}"
                           Foreground="White"
                           FontFamily="{DynamicResource Fonts.Monospace}"
                           FontSize="10"/>
              </Border>
            </Grid>
            <TextBlock Text="{DynamicResource Text.Stashes}" FontSize="12" HorizontalAlignment="Center"/>
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem IsVisible="{Binding !IsBare}" ToolTip.Tip="{DynamicResource Text.TaskCompare.Open}">
          <StackPanel Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Path Width="24" Height="24" Data="{StaticResource Icons.Compare}"/>
            <TextBlock Text="{DynamicResource Text.TaskCompare.Title}" FontSize="12" HorizontalAlignment="Center"/>
          </StackPanel>
        </ListBoxItem>
      </ListBox>
      
      <Button Grid.Row="2"
              Classes="icon_button"
              Width="40" Height="40"
              Margin="4,0"
              Click="OnOpenConfigure"
              ToolTip.Tip="{DynamicResource Text.Repository.Configure}"
              ToolTip.Placement="Right">
        <Path Width="18" Height="18" Data="{StaticResource Icons.Settings}"/>
      </Button>
    </Grid>

    <!-- Body -->
    <Border Grid.Column="1"
            Margin="0,0,4,4"
            BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Border0}"
            CornerRadius="8">
      <Border CornerRadius="8" ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,*">
          <!-- In-Progress Information Bar -->
          <Grid Grid.Row="0"
                MinHeight="28"
                ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto"
                Background="{DynamicResource Brush.Conflict}"
                ToolTip.Tip="{Binding InProgressBannerTooltip, Mode=OneWay}"
                IsVisible="{Binding HasInProgressBanner, Mode=OneWay}">
            <Border Grid.Column="0"
                    Height="18"
                    Margin="8,0,0,0"
                    Padding="7,0"
                    CornerRadius="9"
                    VerticalAlignment="Center"
                    Background="#33000000"
                    IsVisible="{Binding HasInProgressOriginLabel, Mode=OneWay}">
              <TextBlock FontSize="11"
                         FontWeight="Bold"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource Brush.Conflict.Foreground}"
                         Text="{Binding InProgressOriginLabel, Mode=OneWay}"/>
            </Border>

            <Grid Grid.Column="1" Margin="8,0" ColumnDefinitions="*,Auto">
              <ContentControl Grid.Column="0" Content="{Binding InProgressContext}">
              <ContentControl.DataTemplates>
                <DataTemplate DataType="m:Commit">
                  <StackPanel MinWidth="400" Orientation="Vertical">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <v:Avatar Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" IsHitTestVisible="False" User="{Binding Author}"/>
                      <TextBlock Grid.Column="1" Text="{Binding Author.Name}" Margin="8,0,0,0"/>
                      <v:DateTimePresenter Grid.Column="2"
                                           Margin="8,0,0,0"
                                           Timestamp="{Binding CommitterTime}"
                                           Foreground="{DynamicResource Brush.FG2}"/>
                    </Grid>

                    <TextBlock Margin="0,8,0,0" Text="{Binding Subject}" TextWrapping="Wrap"/>
                  </StackPanel>
                </DataTemplate>

                <DataTemplate DataType="vm:CherryPickInProgress">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontWeight="Bold" Foreground="{DynamicResource Brush.Conflict.Foreground}" Text="{DynamicResource Text.InProgress.CherryPick}"/>
                    <TextBlock FontWeight="Bold" Margin="4,0,0,0" Foreground="{DynamicResource Brush.Conflict.Foreground}" Text="{DynamicResource Text.InProgress.CherryPick.Head}" IsVisible="{Binding HeadName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock FontWeight="Bold"
                               Margin="4,0,0,0"
                               Foreground="DarkOrange"
                               FontFamily="{DynamicResource Fonts.Monospace}"
                               Text="{Binding Head.SHA, Converter={x:Static c:StringConverters.ToShortSHA}}"
                               IsVisible="{Binding HeadName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               ToolTip.Tip="{Binding Head}"/>
                  </StackPanel>
                </DataTemplate>

                <DataTemplate DataType="vm:RebaseInProgress">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontWeight="Bold" Foreground="{DynamicResource Brush.Conflict.Foreground}" Text="{DynamicResource Text.InProgress.Rebase}"/>
                    <TextBlock FontWeight="Bold" Margin="4,0,0,0" Foreground="{DynamicResource Brush.Conflict.Foreground}"
                               Text="{DynamicResource Text.InProgress.Rebase.StoppedAt}"
                               IsVisible="{Binding StoppedAt, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock FontWeight="Bold"
                               Margin="4,0,0,0"
                               Foreground="DarkOrange"
                               Text="{Binding StoppedAt.SHA, Converter={x:Static c:StringConverters.ToShortSHA}}"
                               FontFamily="{DynamicResource Fonts.Monospace}"
                               IsVisible="{Binding StoppedAt, Converter={x:Static ObjectConverters.IsNotNull}}"
                               ToolTip.Tip="{Binding StoppedAt}" />
                  </StackPanel>
                </DataTemplate>

                <DataTemplate DataType="vm:RevertInProgress">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontWeight="Bold" Foreground="{DynamicResource Brush.Conflict.Foreground}" Text="{DynamicResource Text.InProgress.Revert}"/>
                    <TextBlock FontWeight="Bold" Margin="4,0,0,0" Foreground="{DynamicResource Brush.Conflict.Foreground}" Text="{DynamicResource Text.InProgress.Revert.Head}" IsVisible="{Binding Head.SHA, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock FontWeight="Bold"
                               Margin="4,0,0,0"
                               Foreground="DarkOrange"
                               FontFamily="{DynamicResource Fonts.Monospace}"
                               Text="{Binding Head.SHA, Converter={x:Static c:StringConverters.ToShortSHA}}"
                               IsVisible="{Binding Head.SHA, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               ToolTip.Tip="{Binding Head}"/>
                  </StackPanel>
                </DataTemplate>

                <DataTemplate DataType="vm:MergeInProgress">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontWeight="Bold" Foreground="{DynamicResource Brush.Conflict.Foreground}" Text="{DynamicResource Text.InProgress.Merge}"/>
                    <TextBlock FontWeight="Bold" Margin="4,0,0,0" Foreground="{DynamicResource Brush.Conflict.Foreground}" Text="{DynamicResource Text.InProgress.Merge.Operating}" IsVisible="{Binding SourceName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock FontWeight="Bold" Margin="4,0,0,0" Foreground="DarkOrange" Text="{Binding SourceName}" ToolTip.Tip="{Binding Source}" IsVisible="{Binding SourceName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock FontWeight="Bold" Margin="4,0,0,0" Foreground="{DynamicResource Brush.Conflict.Foreground}" Text="→" IsVisible="{Binding SourceName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock FontWeight="Bold" Margin="4,0,0,0" Foreground="DarkOrange" Text="{Binding Current}" IsVisible="{Binding SourceName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>
                </DataTemplate>

                <DataTemplate DataType="vm:AmInProgress">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontWeight="Bold" Foreground="{DynamicResource Brush.Conflict.Foreground}" Text="{DynamicResource Text.InProgress.Am}"/>
                    <TextBlock FontWeight="Bold"
                               Margin="4,0,0,0"
                               Foreground="{DynamicResource Brush.Conflict.Foreground}"
                               FontFamily="{DynamicResource Fonts.Monospace}"
                               Text="{Binding Progress, Mode=OneWay}"/>
                  </StackPanel>
                </DataTemplate>

                <DataTemplate DataType="vm:BisectInProgress">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontWeight="Bold" Foreground="{DynamicResource Brush.Conflict.Foreground}" Text="{DynamicResource Text.InProgress.Bisect}"/>
                  </StackPanel>
                </DataTemplate>
              </ContentControl.DataTemplates>
              </ContentControl>

              <TextBlock Grid.Column="0"
                         FontWeight="Bold"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource Brush.Conflict.Foreground}"
                         IsVisible="{Binding HasInProgressHeadlineFallback, Mode=OneWay}"
                         Text="{Binding InProgressHeadlineFallback, Mode=OneWay}"/>

              <Border Grid.Column="1"
                      Height="18"
                      Margin="8,0,0,0"
                      Padding="7,0"
                      CornerRadius="9"
                      VerticalAlignment="Center"
                      Background="#24000000"
                      IsVisible="{Binding HasInProgressConflictBadge, Mode=OneWay}">
                <TextBlock FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Conflict.Foreground}"
                           Text="{Binding InProgressConflictBadgeText, Mode=OneWay}"/>
              </Border>
            </Grid>

            <v:LoadingIcon Grid.Column="2"
                           Width="14" Height="14"
                           Margin="4,0"
                           IsVisible="{Binding IsSkippingOrAbortingMerge, Mode=OneWay}">
              <v:LoadingIcon.Styles>
                <Style Selector="Path">
                  <Setter Property="Fill" Value="Black"/>
                </Style>
              </v:LoadingIcon.Styles>
            </v:LoadingIcon>

            <Button Grid.Column="3"
                    Classes="flat"
                    FontWeight="Regular"
                    BorderThickness="0"
                    Content="{DynamicResource Text.Repository.RefreshStatus}"
                    Padding="8,2" Margin="0,0,6,0"
                    Click="OnRefreshInProgress"/>

            <Button Grid.Column="4"
                    Classes="flat"
                    FontWeight="Regular"
                    BorderThickness="0"
                    Content="{DynamicResource Text.Repository.Resolve}"
                    Padding="8,2" Margin="0,0,6,0"
                    Click="OnResolveInProgress"
                    IsVisible="{Binding CanViewConflictsFromBanner, Mode=OneWay}"/>

            <Button Grid.Column="5"
                    Classes="flat"
                    FontWeight="Regular"
                    BorderThickness="0"
                    Content="{DynamicResource Text.Repository.Abort}"
                    Padding="8,2" Margin="0,0,8,0"
                    IsVisible="{Binding CanAbortInProgressFromBanner, Mode=OneWay}"
                    Click="OnAbortInProgress"/>
          </Grid>

          <StackPanel Grid.Row="1" Orientation="Vertical">
            <Border Background="{DynamicResource Brush.SubPanel}" BorderBrush="{DynamicResource Brush.Border0}" BorderThickness="0,0,0,1" Padding="10,5">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Path Grid.Column="0" Width="12" Height="12" Margin="0,0,8,0"
                      VerticalAlignment="Center"
                      Fill="{DynamicResource Brush.FG2}"
                      Data="{StaticResource Icons.Branch}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusSummary}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           ToolTip.Tip="{Binding StatusSummaryDetail}"/>
                <Button Grid.Column="2"
                        Classes="flat"
                        Height="24"
                        Margin="12,0,0,0"
                        Padding="10,0"
                        CornerRadius="4"
                        FontSize="12"
                        FontWeight="Normal"
                        VerticalAlignment="Center"
                        Content="{DynamicResource Text.Repository.ViewChanges}"
                        Command="{Binding ShowChanges}"/>
              </Grid>
            </Border>

            <Border Background="#22FF8C00"
                    BorderBrush="{DynamicResource Brush.Border0}"
                    BorderThickness="0,0,0,1"
                    Padding="10,5"
                    IsVisible="{Binding ShowPendingRecoveryBanner, Mode=OneWay}">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Path Grid.Column="0" Width="13" Height="13" Margin="0,0,8,0"
                      VerticalAlignment="Center"
                      Fill="DarkOrange"
                      Data="{StaticResource Icons.Info}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding PendingRecoverySummary, Mode=OneWay}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding PendingRecoverySummary, Mode=OneWay}"/>
                <Button Grid.Column="2"
                        Classes="flat primary"
                        Height="24"
                        Margin="12,0,0,0"
                        Padding="10,0"
                        CornerRadius="4"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Content="{DynamicResource Text.OperationRecovery.BannerOpen}"
                        Click="OnOpenRecoveryLogs"/>
                <Button Grid.Column="3"
                        Classes="flat"
                        Height="24"
                        Margin="6,0,0,0"
                        Padding="10,0"
                        CornerRadius="4"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Content="{DynamicResource Text.OperationRecovery.BannerDismiss}"
                        Click="OnDismissRecoveryBanner"/>
              </Grid>
            </Border>
          </StackPanel>

          <!-- Main Body -->
          <Grid Grid.Row="2" Background="{DynamicResource Brush.Window}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{Binding #ThisControl.SidebarWidth, Mode=TwoWay}" MinWidth="{Binding #ThisControl.SidebarMinWidth, Mode=OneWay}"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*" MinWidth="100"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar (Branches/Remotes/Tags/Submodules/Worktrees) -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*" IsVisible="{Binding #ThisControl.IsNormalSidebarVisible, Mode=OneWay}">              
              <!-- Filter Branches/Tags/Submodules -->
              <TextBox Grid.Row="0"
                       x:Name="FilterBox"
                       Height="24"
                       Margin="6,6,4,0"
                       BorderThickness="1"
                       CornerRadius="13"
                       BorderBrush="{DynamicResource Brush.Border2}"
                       Watermark="{DynamicResource Text.Repository.Filter}"
                       Text="{Binding Filter, Mode=TwoWay}"
                       VerticalContentAlignment="Center">
                <TextBox.InnerLeftContent>
                  <Path Width="14" Height="14"
                        Margin="6,0,0,0"
                        Fill="{DynamicResource Brush.FG2}"
                        Data="{StaticResource Icons.Search}"/>
                </TextBox.InnerLeftContent>

                <TextBox.InnerRightContent>
                  <Button Classes="icon_button"
                          Focusable="False"
                          Width="16"
                          Margin="0,0,6,0"
                          Command="{Binding ClearFilter}"
                          IsVisible="{Binding Filter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                          HorizontalAlignment="Right">
                    <Path Width="14" Height="14"
                          Margin="0,1,0,0"
                          Fill="{DynamicResource Brush.FG1}"
                          Data="{StaticResource Icons.Clear}"/>
                  </Button>
                </TextBox.InnerRightContent>
              </TextBox>

              <Grid Grid.Row="1" x:Name="LeftSidebarGroups" Margin="0,4,0,0" RowDefinitions="28,Auto,28,Auto,28,Auto,28,Auto,28,Auto" SizeChanged="OnLeftSidebarSizeChanged">
                <!-- Local Branches -->
                <ToggleButton Grid.Row="0" Classes="group_expander" IsChecked="{Binding IsLocalBranchGroupExpanded, Mode=TwoWay}">
                  <Grid ColumnDefinitions="16,*,Auto">
                    <Path Grid.Column="0" Width="11" Height="11" HorizontalAlignment="Left" Data="{StaticResource Icons.Local}" Fill="{DynamicResource Brush.FG2}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <TextBlock Classes="group_header_label" Text="{DynamicResource Text.Repository.LocalBranches}"/>
                      <TextBlock Classes="group_header_label" Text="{Binding LocalBranchesCount, StringFormat='({0})'}" Margin="4,0,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Classes="icon_button"
                            Width="14"
                            Margin="8,0"
                            Click="OnOpenSortLocalBranchMenu"
                            ToolTip.Tip="{DynamicResource Text.Repository.BranchSort}">
                      <Grid>
                        <Path Width="12" Height="12" Data="{StaticResource Icons.OrderByName}" IsVisible="{Binding IsSortingLocalBranchByName, Mode=OneWay}"/>
                        <Path Width="12" Height="12" Data="{StaticResource Icons.OrderByTime}" IsVisible="{Binding !IsSortingLocalBranchByName, Mode=OneWay}"/>
                      </Grid>
                    </Button>
                  </Grid>
                </ToggleButton>
                <v:BranchTree Grid.Row="1"
                              x:Name="LocalBranchTree"
                              Height="0"
                              Margin="6,0,4,0"
                              Nodes="{Binding LocalBranchTrees}"
                              IsVisible="{Binding IsLocalBranchGroupExpanded}"
                              SelectionChanged="OnLocalBranchTreeSelectionChanged"
                              RowsChanged="OnLeftSidebarRowsChanged"
                              SearchRequested="OnToggleSidebarFilter"/>

                <!-- Remotes -->
                <ToggleButton Grid.Row="2" Classes="group_expander" IsChecked="{Binding IsRemoteGroupExpanded, Mode=TwoWay}">
                  <Grid ColumnDefinitions="16,*,Auto,Auto">
                    <Path Grid.Column="0" Width="11" Height="11" HorizontalAlignment="Left" Data="{StaticResource Icons.Remotes}" Fill="{DynamicResource Brush.FG2}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <TextBlock Classes="group_header_label" Text="{DynamicResource Text.Repository.Remotes}"/>
                      <TextBlock Classes="group_header_label" Text="{Binding Remotes, Converter={x:Static c:ListConverters.ToCount}}" Margin="4,0,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Classes="icon_button"
                            Width="14"
                            Margin="8,0,0,0"
                            Click="OnOpenSortRemoteBranchMenu"
                            ToolTip.Tip="{DynamicResource Text.Repository.BranchSort}">
                      <Grid>
                        <Path Width="12" Height="12" Data="{StaticResource Icons.OrderByName}" IsVisible="{Binding IsSortingRemoteBranchByName, Mode=OneWay}"/>
                        <Path Width="12" Height="12" Data="{StaticResource Icons.OrderByTime}" IsVisible="{Binding !IsSortingRemoteBranchByName, Mode=OneWay}"/>
                      </Grid>
                    </Button>
                    <Button Grid.Column="3" Classes="icon_button" Width="14" Margin="8,0" Command="{Binding AddRemote}" ToolTip.Tip="{DynamicResource Text.Repository.Remotes.Add}">
                      <Path Width="12" Height="12" Data="{StaticResource Icons.Remote.Add}"/>
                    </Button>
                  </Grid>
                </ToggleButton>
                <v:BranchTree Grid.Row="3"
                              x:Name="RemoteBranchTree"
                              Height="0"
                              Margin="6,0,4,0"
                              Nodes="{Binding RemoteBranchTrees}"
                              IsVisible="{Binding IsRemoteGroupExpanded}"
                              SelectionChanged="OnRemoteBranchTreeSelectionChanged"
                              RowsChanged="OnLeftSidebarRowsChanged"
                              SearchRequested="OnToggleSidebarFilter"/>

                <!-- Tags -->
                <ToggleButton Grid.Row="4" Classes="group_expander" IsChecked="{Binding IsTagGroupExpanded, Mode=TwoWay}">
                  <Grid ColumnDefinitions="16,*,Auto,Auto">
                    <Path Grid.Column="0" Width="11" Height="11" Margin="0,1,0,0" HorizontalAlignment="Left" Data="{StaticResource Icons.Tags}" Fill="{DynamicResource Brush.FG2}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <TextBlock Classes="group_header_label" Text="{DynamicResource Text.Repository.Tags}"/>
                      <TextBlock Classes="group_header_label" Text="{Binding Tags, Converter={x:Static c:ListConverters.ToCount}}" Margin="4,0,0,0"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="2"
                                  Classes="line_path"
                                  Width="14"
                                  IsChecked="{Binding ShowTagsAsTree, Mode=TwoWay}"
                                  ToolTip.Tip="{DynamicResource Text.Repository.ShowTagsAsTree}">
                      <Path Width="11" Height="11" Data="{DynamicResource Icons.Tree}"/>
                    </ToggleButton>
                    <Button Grid.Column="3"
                            Classes="icon_button"
                            Width="14"
                            Margin="8,0"
                            Click="OnOpenSortTagMenu"
                            ToolTip.Tip="{DynamicResource Text.Repository.Tags.Sort}">
                      <Grid>
                        <Path Width="12" Height="12" Data="{StaticResource Icons.OrderByName}" IsVisible="{Binding IsSortingTagsByName, Mode=OneWay}"/>
                        <Path Width="12" Height="12" Data="{StaticResource Icons.OrderByTime}" IsVisible="{Binding !IsSortingTagsByName, Mode=OneWay}"/>
                      </Grid>
                    </Button>
                  </Grid>
                </ToggleButton>
                <v:TagsView Grid.Row="5"
                            x:Name="TagsList"
                            Height="0"
                            Margin="6,0,4,0"
                            Background="Transparent"
                            Content="{Binding VisibleTags}"
                            Focusable="False"
                            IsVisible="{Binding IsTagGroupExpanded, Mode=OneWay}"
                            SelectionChanged="OnTagsSelectionChanged"
                            RowsChanged="OnLeftSidebarRowsChanged"
                            SearchRequested="OnToggleSidebarFilter"/>

                <!-- Submodules -->
                <ToggleButton Grid.Row="6" Classes="group_expander" IsChecked="{Binding IsSubmoduleGroupExpanded, Mode=TwoWay}">
                  <Grid ColumnDefinitions="16,*,Auto">
                    <Path Grid.Column="0" Width="11" Height="11" HorizontalAlignment="Left" Data="{StaticResource Icons.Submodules}" Fill="{DynamicResource Brush.FG2}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <TextBlock Classes="group_header_label" Text="{DynamicResource Text.Repository.Submodules}"/>
                      <TextBlock Classes="group_header_label" Text="{Binding Submodules, Converter={x:Static c:ListConverters.ToCount}}" Margin="4,0,0,0"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="2"
                                  Classes="line_path"
                                  Width="14"
                                  Margin="0,0,8,0"
                                  IsChecked="{Binding ShowSubmodulesAsTree, Mode=TwoWay}"
                                  IsVisible="{Binding Submodules, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"
                                  ToolTip.Tip="{DynamicResource Text.Repository.ShowSubmodulesAsTree}">
                      <Path Width="11" Height="11" Data="{DynamicResource Icons.Tree}"/>
                    </ToggleButton>
                  </Grid>
                </ToggleButton>
                <v:SubmodulesView Grid.Row="7"
                                  x:Name="SubmoduleList"
                                  Height="0"
                                  Margin="6,0,4,0"
                                  Content="{Binding VisibleSubmodules}"
                                  RowsChanged="OnLeftSidebarRowsChanged"
                                  Focusable="False"
                                  IsVisible="{Binding IsSubmoduleGroupExpanded, Mode=OneWay}"
                                  SearchRequested="OnToggleSidebarFilter"/>

                <!-- Worktrees -->
                <ToggleButton Grid.Row="8" Classes="group_expander" IsChecked="{Binding IsWorktreeGroupExpanded, Mode=TwoWay}">
                  <Grid ColumnDefinitions="16,*,Auto,Auto">
                    <Path Grid.Column="0" Width="11" Height="11" HorizontalAlignment="Left" Data="{StaticResource Icons.Worktrees}" Fill="{DynamicResource Brush.FG2}"/>
                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ClipToBounds="True" ToolTip.Tip="{DynamicResource Text.Repository.Worktrees}">
                      <TextBlock Grid.Column="0" Classes="group_header_label" TextTrimming="CharacterEllipsis" Text="{DynamicResource Text.Repository.Worktrees}"/>
                      <TextBlock Grid.Column="1" Classes="group_header_label" Text="{Binding Worktrees, Converter={x:Static c:ListConverters.ToCount}}" Margin="4,0,0,0"/>
                    </Grid>
                    <Button Grid.Column="2"
                            Classes="icon_button"
                            Width="14"
                            Margin="6,0"
                            Command="{Binding RefreshTaskOverview}"
                            IsVisible="{Binding Worktrees, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"
                            ToolTip.Tip="{DynamicResource Text.Worktree.Task.Refresh}">
                      <Path Width="12" Height="12" Data="{StaticResource Icons.Loading}"/>
                    </Button>
                    <Button Grid.Column="3"
                            Classes="icon_button"
                            Width="14"
                            Margin="0,0,9,0"
                            Click="OnPruneWorktrees"
                            IsVisible="{Binding Worktrees, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"
                            ToolTip.Tip="{DynamicResource Text.PruneWorktrees}">
                      <Path Width="11" Height="11" Data="{StaticResource Icons.Clean}"/>
                    </Button>
                  </Grid>
                </ToggleButton>
                <ListBox Grid.Row="9"
                         x:Name="WorktreeList"
                         Height="0"
                         Margin="6,0,4,0"
                         Classes="repo_left_content_list worktree_tasks"
                         ItemsSource="{Binding Worktrees, Mode=OneWay}"
                         SelectionMode="Single"
                         PropertyChanged="OnWorktreeListPropertyChanged"
                         IsVisible="{Binding IsWorktreeGroupExpanded, Mode=OneWay}">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:Worktree">
                      <Border Height="128"
                              Background="Transparent"
                              DoubleTapped="OnWorktreeDoubleTapped"
                              ContextRequested="OnWorktreeContextRequested"
                              ToolTip.Placement="Right">
                        <ToolTip.Tip>
                          <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                              <v:WorktreeIcon Width="12" Height="12"/>
                              <TextBlock FontWeight="Bold" Margin="8,0,0,0" Text="{Binding Name, Mode=OneWay}"/>
                            </StackPanel>

                            <TextBlock Text="{Binding ChangesDescription}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding SyncDescription}"/>
                            <TextBlock Text="{Binding AvailabilityDescription}"/>
                            <TextBlock Text="{Binding RefreshDescription}"/>
                            <TextBlock Text="{Binding FetchDescription}"/>
                            <Grid RowDefinitions="24,24,24" ColumnDefinitions="Auto,16,Auto,Auto" Margin="0,8,0,0">
                              <TextBlock Grid.Row="0" Grid.Column="0"
                                         Classes="info_label"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Text="{DynamicResource Text.Worktree.Branch}"/>
                              <Path Grid.Row="0" Grid.Column="2"
                                    Width="14" Height="14"
                                    Margin="2,0,0,0"
                                    Data="{StaticResource Icons.Branch}"/>
                              <TextBlock Grid.Row="0" Grid.Column="3"
                                         Margin="6,0,0,0"
                                         Text="{Binding Branch, Mode=OneWay}"/>

                              <TextBlock Grid.Row="1" Grid.Column="0"
                                         Classes="info_label"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Text="{DynamicResource Text.Worktree.Path}"/>
                              <Path Grid.Row="1" Grid.Column="2"
                                    Width="14" Height="14"
                                    Margin="2,0,0,0"
                                    Data="{StaticResource Icons.Folder.Open}"/>
                              <TextBlock Grid.Row="1" Grid.Column="3"
                                         Margin="6,0,0,0"
                                         Text="{Binding FullPath, Mode=OneWay}"/>

                              <TextBlock Grid.Row="2" Grid.Column="0"
                                         Classes="info_label"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Text="{DynamicResource Text.Worktree.Head}"/>
                              <Path Grid.Row="2" Grid.Column="2"
                                    Width="14" Height="14"
                                    Data="{StaticResource Icons.Commit}"/>
                              <TextBlock Grid.Row="2" Grid.Column="3"
                                         Margin="6,0,0,0"
                                         Text="{Binding Head, Mode=OneWay, Converter={x:Static c:StringConverters.ToShortSHA}}"/>
                            </Grid>
                          </StackPanel>
                        </ToolTip.Tip>
                        <Grid>
                          <Grid Margin="0,5,6,5" RowDefinitions="22,20,18,18,18,18" ColumnDefinitions="9,Auto,Auto,*,Auto" VerticalAlignment="Center">
                            <v:WorktreeDepthIcon Grid.Column="1" Brush="{DynamicResource Brush.Border1}"/>
                            <v:WorktreeIcon Grid.Column="2"
                                            Width="11" Height="11"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.FG1}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Name, Mode=OneWay}"
                                       FontWeight="{Binding IsCurrent, Mode=OneWay, Converter={x:Static c:BoolConverters.IsBoldToFontWeight}}"/>
                            <Path Grid.Column="4"
                                  Width="10" Height="10"
                                  Margin="6,0,2,0"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource Icons.Lock}"
                                  Fill="{DynamicResource Brush.FG2}"
                                  IsVisible="{Binding IsLocked, Mode=OneWay}"/>

                            <Grid Grid.Row="1" Grid.ColumnSpan="5" Margin="16,0,0,0" ColumnDefinitions="Auto,*,Auto">
                              <Path Grid.Column="0" Width="10" Height="10" Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Fill="{DynamicResource Brush.FG2}"
                                    Data="{StaticResource Icons.Branch}"/>
                              <TextBlock Grid.Column="1"
                                         FontSize="12"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource Brush.FG1}"
                                         Text="{Binding Branch}"
                                         TextTrimming="CharacterEllipsis"
                                         ToolTip.Tip="{Binding BranchDescription}"/>
                              <Border Grid.Column="2" Margin="6,0,0,0" Height="16" Padding="5,0"
                                      CornerRadius="3" VerticalAlignment="Center"
                                      BorderThickness="1" BorderBrush="#662DA44E"
                                      Background="#1C2DA44E"
                                      IsVisible="{Binding IsTaskCompleted}">
                                <TextBlock FontSize="10.5"
                                           Foreground="{DynamicResource Brush.FG1}"
                                           Text="{Binding TaskState}"
                                           VerticalAlignment="Center"/>
                              </Border>
                              <Border Grid.Column="2" Margin="6,0,0,0" Height="16" Padding="5,0"
                                      CornerRadius="3" VerticalAlignment="Center"
                                      BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}"
                                      IsVisible="{Binding !IsTaskCompleted}">
                                <TextBlock FontSize="10.5"
                                           Foreground="{DynamicResource Brush.FG2}"
                                           Text="{Binding TaskState}"
                                           VerticalAlignment="Center"/>
                              </Border>
                            </Grid>

                            <TextBlock Grid.Row="2" Grid.ColumnSpan="5" Margin="16,0,0,0"
                                       FontSize="11.5" VerticalAlignment="Center"
                                       Text="{Binding FullPath}" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding FullPath}" Foreground="{DynamicResource Brush.FG2}"/>
                            <TextBlock Grid.Row="3" Grid.ColumnSpan="5" Margin="16,0,0,0"
                                       FontSize="11.5" VerticalAlignment="Center"
                                       Text="{Binding ChangesDescription}" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding ChangesDescription}"/>
                            <TextBlock Grid.Row="4" Grid.ColumnSpan="5" Margin="16,0,0,0"
                                       FontSize="11.5" VerticalAlignment="Center"
                                       Text="{Binding SyncDescription}" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding SyncDescription}" Foreground="{DynamicResource Brush.FG2}"/>
                            <TextBlock Grid.Row="5" Grid.ColumnSpan="5" Margin="16,0,0,0"
                                       FontSize="11" VerticalAlignment="Center"
                                       Text="{Binding RefreshDescription}" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding RefreshDescription}" Foreground="{DynamicResource Brush.FG2}"/>
                          </Grid>

                          <Border Height="1" Margin="8,0"
                                  VerticalAlignment="Bottom"
                                  Background="{DynamicResource Brush.Border0}"
                                  Opacity="0.45"
                                  IsVisible="{Binding !IsLast}"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Grid>

            <!-- Commit Search Panel -->
            <v:CommitSearchView Grid.Column="0"
                                Margin="6,0,4,0"
                                DataContext="{Binding Histories.SearchCommitContext, Mode=OneWay}"
                                IsVisible="{Binding #ThisControl.IsCommitSearchPanelVisible, Mode=OneWay}"/>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          Width="3" MinWidth="3" MaxWidth="3"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent"
                          BorderThickness="0,0,1,0"
                          BorderBrush="{DynamicResource Brush.Border0}"
                          Focusable="False">
              <GridSplitter.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                  <Binding ElementName="ThisControl" Path="IsCommitSearchPanelVisible"/>
                  <Binding ElementName="ThisControl" Path="IsNormalSidebarVisible"/>
                </MultiBinding>
              </GridSplitter.IsVisible>
            </GridSplitter>

            <!-- Right Page -->
            <Grid Grid.Column="2">
              <!-- Dashboard (History) Page -->
              <Border IsVisible="{Binding IsDashboardVisible, Mode=OneWay}" PropertyChanged="OnRightPagePropertyChanged">
                <Grid RowDefinitions="Auto,*" Background="{DynamicResource Brush.SubPanel}">
                  <!-- History Filter Bar -->
                  <Border Grid.Row="0"
                          Background="{DynamicResource Brush.Popup}"
                          BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}"
                          IsVisible="{Binding UIStates.HistoryFilters.Count, Converter={x:Static c:IntConverters.IsGreaterThanZero}}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                      <Path Grid.Column="0"
                            Margin="8,0,0,0"
                            Width="12" Height="12"
                            Data="{StaticResource Icons.Filter}"
                            Fill="{DynamicResource Brush.FG2}"
                            IsVisible="{Binding HistoryFilterMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:FilterMode.Included}}"/>
                      <Path Grid.Column="0"
                            Margin="8,0,0,0"
                            Width="12" Height="12"
                            Data="{StaticResource Icons.EyeClose}"
                            Fill="{DynamicResource Brush.FG2}"
                            IsVisible="{Binding HistoryFilterMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:FilterMode.Excluded}}"/>

                      <ItemsControl Grid.Column="1"
                                    Margin="8,4"
                                    ItemsSource="{Binding UIStates.HistoryFilters}"
                                    IsVisible="{Binding !IsHistoryFiltersCollapsed, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemHeight="22"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="m:HistoryFilter">
                            <Border Height="20"
                                    Margin="0,0,6,0"
                                    CornerRadius="12"
                                    BorderThickness="1"
                                    BorderBrush="{Binding Mode, Converter={x:Static c:FilterModeConverters.ToBorderBrush}}"
                                    VerticalAlignment="Center">
                              <Grid Margin="8,0">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto"/>
                                  <ColumnDefinition Width="Auto" MaxWidth="480"/>
                                  <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <v:HistoryFilterIcon Grid.Column="0"
                                                     Width="12" Height="12"
                                                     VerticalAlignment="Center"
                                                     Filter="{Binding Mode=OneWay}"
                                                     IsFilterValid="{Binding IsValid, Mode=OneWay}"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Pattern, Converter={x:Static c:StringConverters.TrimRefsPrefix}}"
                                           Margin="4,0,8,0"
                                           TextTrimming="CharacterEllipsis"/>

                                <Button Grid.Column="2" Classes="icon_button" VerticalAlignment="Center" Margin="0" Padding="0" Click="OnRemoveSelectedHistoryFilter">
                                  <Path Width="8" Height="8" Data="{StaticResource Icons.Close}"/>
                                </Button>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <Border Grid.Column="1"
                              Height="30"
                              Margin="6,0,0,0"
                              IsVisible="{Binding IsHistoryFiltersCollapsed, Mode=OneWay}">
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Brush.FG2}">
                          <Run Text="{Binding UIStates.HistoryFilters.Count, Mode=OneWay}" FontWeight="Bold"/>
                          <Run Text="{DynamicResource Text.Repository.FilterCommits.Summary}"/>
                        </TextBlock>
                      </Border>

                      <ToggleButton Grid.Column="2"
                                    Classes="filter_expander"
                                    Width="20"
                                    Margin="16,0,0,0"
                                    Background="Transparent"
                                    IsChecked="{Binding IsHistoryFiltersCollapsed, Mode=TwoWay}"/>

                      <Button Grid.Column="3"
                              Width="20"
                              Margin="0,0,12,0"
                              Classes="icon_button"
                              Command="{Binding ClearHistoryFilters}"
                              ToolTip.Tip="{DynamicResource Text.Repository.ClearAllCommitsFilter}">
                        <Path Width="14" Height="14" Margin="0,1,0,0" Data="{StaticResource Icons.RemoveAll}"/>
                      </Button>
                    </Grid>
                  </Border>

                  <!-- History -->
                  <v:Histories Grid.Row="1"
                               DataContext="{Binding Histories, Mode=OneWay}"
                               CurrentBranch="{Binding CurrentBranch, Mode=OneWay}"
                               HasSingleRemote="{Binding HasSingleRemote, Mode=OneWay}"
                               IssueTrackers="{Binding IssueTrackers, Mode=OneWay}">
                    <v:Histories.IsDetailsPanelExpanded>
                      <MultiBinding Converter="{x:Static BoolConverters.Or}">
                        <Binding Source="{x:Static vm:Preferences.Instance}" Path="UseTwoColumnsLayoutInHistories" Mode="OneWay"/>
                        <Binding Path="IsCollapseDetails" Converter="{x:Static BoolConverters.Not}" Mode="OneWay"/>
                      </MultiBinding>
                    </v:Histories.IsDetailsPanelExpanded>
                  </v:Histories>
                </Grid>
              </Border>

              <!-- Local Changes Page -->
              <Border IsVisible="{Binding IsWorkingCopyVisible, Mode=OneWay}" PropertyChanged="OnRightPagePropertyChanged">
                <v:WorkingCopy DataContext="{Binding WorkingCopy, Mode=OneWay}"/>
              </Border>

              <!-- Stashes Page -->
              <Border IsVisible="{Binding IsStashesVisible, Mode=OneWay}" PropertyChanged="OnRightPagePropertyChanged">
                <v:StashesPage DataContext="{Binding StashesPage, Mode=OneWay}"/>
              </Border>

              <Border IsVisible="{Binding IsTaskComparisonVisible}" PropertyChanged="OnRightPagePropertyChanged">
                <v:TaskComparison DataContext="{Binding TaskComparison}"/>
              </Border>

              <!-- Auto-Fetch Notification -->
              <Border Padding="12" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="drop-shadow(0 0 12 #A0000000)" IsVisible="{Binding IsAutoFetching}">
                <Border Background="{DynamicResource Brush.Popup}" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Brush.PopupBorder}">
                  <StackPanel Orientation="Vertical" Margin="16,8">
                    <TextBlock Text="{DynamicResource Text.Repository.AutoFetching}"/>
                    <ProgressBar Margin="0,8,0,0"
                                 HorizontalAlignment="Stretch"
                                 IsIndeterminate="{Binding IsAutoFetching}"
                                 Background="{DynamicResource Brush.FG2}" Foreground="{DynamicResource Brush.Accent}"
                                 Minimum="0" Maximum="100"/>
                  </StackPanel>
                </Border>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </Border>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="520"
             Background="{DynamicResource Brush.Window}"
             x:Class="SourceGit.Views.Conflict"
             x:DataType="vm:Conflict">
  <ScrollViewer Background="{DynamicResource Brush.Window}"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Orientation="Vertical" Margin="14,10" Spacing="8">
      <!-- Top Conflict Alert Header -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Path Grid.Column="0"
              Width="20" Height="20"
              VerticalAlignment="Center"
              Data="{StaticResource Icons.Conflict}"
              Fill="{DynamicResource Brush.Conflict}"/>
        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" Spacing="2">
          <TextBlock FontSize="15"
                     Classes="bold"
                     Text="{DynamicResource Text.WorkingCopy.Conflicts}"/>
          <TextBlock FontSize="12"
                     FontFamily="{DynamicResource Fonts.Monospace}"
                     Foreground="{DynamicResource Brush.FG2}"
                     TextWrapping="Wrap"
                     Text="{Binding ChangePath, Mode=OneWay}"/>
        </StackPanel>
        <Button Grid.Column="2"
                Classes="flat primary"
                Height="26"
                Padding="12,0"
                VerticalAlignment="Center"
                IsEnabled="{Binding !IsRefreshing, Mode=OneWay}"
                Content="{DynamicResource Text.Repository.RefreshStatus}"
                Click="OnRefreshStatus"/>
      </Grid>

      <!-- Selected Change Marker & Conflict Reason -->
      <Border Background="{DynamicResource Brush.Contents}"
              BorderBrush="{DynamicResource Brush.Border1}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="10,6">
        <Grid ColumnDefinitions="Auto,*">
          <Border Grid.Column="0"
                  Background="{DynamicResource Brush.Conflict}"
                  CornerRadius="3"
                  Height="20"
                  MinWidth="24"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding Marker}"
                       Foreground="White"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="6,0"
                       FontSize="11"/>
          </Border>
          <TextBlock Grid.Column="1"
                     Margin="10,0,0,0"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     Text="{Binding Description}"/>
        </Grid>
      </Border>

      <!-- Origin Ownership & Safety Status Card -->
      <Border Padding="10,8"
              CornerRadius="4"
              Background="#1EFF8C00"
              BorderThickness="1"
              BorderBrush="#55FF8C00">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="Auto,*">
            <Border Grid.Column="0"
                    Height="20"
                    Padding="8,0"
                    CornerRadius="10"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Conflict}">
              <TextBlock FontSize="11"
                         FontWeight="Bold"
                         Foreground="White"
                         VerticalAlignment="Center"
                         Text="{Binding OriginLabel, Mode=OneWay}"/>
            </Border>
            <TextBlock Grid.Column="1"
                       Margin="10,0,0,0"
                       Classes="bold"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Text="{Binding Headline, Mode=OneWay}"/>
          </Grid>

          <TextBlock FontSize="12"
                     Foreground="{DynamicResource Brush.FG1}"
                     TextWrapping="Wrap"
                     IsVisible="{Binding HasDetail, Mode=OneWay}"
                     Text="{Binding Detail, Mode=OneWay}"/>

          <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasActiveMarkers, Mode=OneWay}">
            <TextBlock Grid.Column="0"
                       FontSize="11"
                       Foreground="{DynamicResource Brush.FG2}"
                       Margin="0,0,8,0"
                       Text="{DynamicResource Text.WorkingCopy.Conflicts.MarkerLabel}"/>
            <TextBlock Grid.Column="1"
                       FontSize="11"
                       FontFamily="{DynamicResource Fonts.Monospace}"
                       TextWrapping="Wrap"
                       Text="{Binding ActiveMarkersText, Mode=OneWay}"/>
          </Grid>

          <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding ShowExternalAbortDisabledNotice, Mode=OneWay}">
            <Path Grid.Column="0"
                  Width="13" Height="13"
                  Margin="0,2,8,0"
                  VerticalAlignment="Top"
                  Data="{StaticResource Icons.Info}"
                  Fill="DarkOrange"/>
            <TextBlock Grid.Column="1"
                       FontSize="11"
                       Foreground="{DynamicResource Brush.FG2}"
                       TextWrapping="Wrap"
                       Text="{DynamicResource Text.WorkingCopy.Conflicts.ExternalAbortDisabled}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- MINE vs THEIRS Read-Only Context -->
      <Border Background="{DynamicResource Brush.Contents}"
              BorderBrush="{DynamicResource Brush.Border1}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="10,6">
        <Border.DataTemplates>
          <DataTemplate DataType="m:Commit">
            <Grid ColumnDefinitions="Auto,Auto,*">
              <v:CommitRefsPresenter Grid.Column="0"
                                     Foreground="{DynamicResource Brush.FG1}"
                                     FontSize="12"
                                     VerticalAlignment="Center"
                                     UseGraphColor="False"/>
              <TextBlock Grid.Column="1"
                         Margin="4,0,0,0"
                         VerticalAlignment="Center"
                         Text="{Binding SHA, Converter={x:Static c:StringConverters.ToShortSHA}}"
                         FontFamily="{DynamicResource Fonts.Monospace}"
                         Foreground="DarkOrange"
                         TextDecorations="Underline"
                         Cursor="Hand"
                         PointerPressed="OnPressedSHA"/>
              <TextBlock Grid.Column="2"
                         Margin="4,0,0,0"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         Text="{Binding Subject}"/>
            </Grid>
          </DataTemplate>

          <DataTemplate DataType="x:String">
            <StackPanel Orientation="Horizontal">
              <Path Width="12" Height="12" Data="{StaticResource Icons.Changes}"/>
              <TextBlock Margin="4,0,0,0" Text="{Binding}"/>
            </StackPanel>
          </DataTemplate>
        </Border.DataTemplates>

        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Grid.Column="0" Classes="info_label" VerticalAlignment="Center" Text="MINE"/>
          <ContentControl Grid.Row="0" Grid.Column="1" Margin="14,3,0,3" Content="{Binding Mine}"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Classes="info_label" VerticalAlignment="Center" Text="THEIRS"/>
          <ContentControl Grid.Row="1" Grid.Column="1" Margin="14,3,0,3" Content="{Binding Theirs}"/>
        </Grid>
      </Border>

      <!-- Conflicted Files List Card -->
      <Border Background="{DynamicResource Brush.Contents}"
              BorderBrush="{DynamicResource Brush.Border1}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="10,6">
        <StackPanel Spacing="6">
          <TextBlock Classes="bold" FontSize="12" Text="{Binding ConflictedFilesHeader, Mode=OneWay}"/>

          <TextBlock FontSize="11"
                     Foreground="{DynamicResource Brush.FG2}"
                     TextWrapping="Wrap"
                     IsVisible="{Binding HasEmptyConflictedFiles, Mode=OneWay}"
                     Text="{DynamicResource Text.WorkingCopy.Conflicts.EmptyFiles}"/>

          <ItemsControl ItemsSource="{Binding ConflictedFiles}"
                        IsVisible="{Binding HasConflictedFiles, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ConflictFileListItem">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                  <Border Grid.Column="0"
                          Background="{DynamicResource Brush.Conflict}"
                          CornerRadius="2"
                          MinWidth="20"
                          Height="18"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding Marker}"
                               Foreground="White"
                               FontSize="10"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="4,0"/>
                  </Border>
                  <TextBlock Grid.Column="1"
                             FontSize="12"
                             FontFamily="{DynamicResource Fonts.Monospace}"
                             VerticalAlignment="Center"
                             TextWrapping="Wrap"
                             Text="{Binding Path}"/>
                  <TextBlock Grid.Column="2"
                             Margin="8,0,0,0"
                             FontSize="11"
                             Foreground="{DynamicResource Brush.FG2}"
                             VerticalAlignment="Center"
                             Text="{Binding Description}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Read-Only Product Boundary Notice -->
      <Border Background="{DynamicResource Brush.Contents}"
              BorderBrush="{DynamicResource Brush.Border1}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="10,8">
        <Grid ColumnDefinitions="Auto,*">
          <Path Grid.Column="0"
                Width="14" Height="14"
                Margin="0,2,8,0"
                VerticalAlignment="Top"
                Data="{StaticResource Icons.Info}"
                Fill="{DynamicResource Brush.Accent}"/>
          <TextBlock Grid.Column="1"
                     FontSize="12"
                     Foreground="{DynamicResource Brush.FG2}"
                     TextWrapping="Wrap"
                     Text="{DynamicResource Text.WorkingCopy.Conflicts.ReadOnlyNotice}"/>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
